# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so no real value and no
# credential ever belongs here.
#
# One rule for the whole file: an unprefixed SCREAMING_SNAKE name is a framework key — the
# declared key uppercased with `.` and `-` replaced by `_`, so `nav.sign_key` is NAV_SIGN_KEY.
# Anything under an application prefix (APP_) belongs to that application and the framework
# never reads it; this application's own keys happen to be unprefixed, and none of them is in
# the framework's registry. A blank value means *absent*, never an empty override.

# --- 1. Process bootstrap -------------------------------------------------------
# Read by `saas_core::Config` before any setting or secret exists.
# 32 random bytes, base64. Generate one:
#   head -c 32 /dev/urandom | base64
MASTER_KEY=
# Relative to the process, not to this file: run `cargo run -p saas-example` from
# `example/backend` (as `start.sh` does), or these land outside the repo.
DB_PATH=./data/example.db
DATA_DIR=./data
LISTEN=127.0.0.1:8080
BASE_URL=http://localhost:8080
# Job workers this process runs, overriding the `jobs.workers` setting. Per-process, so a
# second replica sharing the database sets it to 0 and runs no runner. Normally unset.
#JOBS_WORKERS=

# --- 2. Framework keys ----------------------------------------------------------
# A setting resolves row, then here, then the application's registered default, then the
# registry default; a secret resolves here **first** and is never written to the table.

# Which environment **both** NAV and the payment gateway run against: test / production.
# Defaults to production — the NAV test system answers OK and reports nothing statutory, so it
# is never what an unconfigured deployment should inherit. One flag, not one per system, on
# purpose: filing statutory invoices while a sandbox gateway takes no money (or the reverse) is
# a failure mode, not a configuration, and two keys made it reachable by forgetting one.
DEPLOYMENT_ENV=test

# Mail. The default `./templates/email` resolves against the backend's cwd (example/backend),
# where there are no templates — `check_email_settings` refuses to boot on it. The repo root's
# are two levels up; `start.sh` exports the same path absolute.
EMAIL_TEMPLATE_DIR=../../templates/email
EMAIL_FROM=noreply@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=noreply@example.com
EMAIL_SMTP_TLS_MODE=starttls
EMAIL_SMTP_PASSWORD=

# Where ALERT_SWEEP mails A-NAV-REJECTED and friends. Empty disables alert mail entirely.
ADMIN_ALERT_EMAIL=

# NAV Online Számla. The three keys are secrets read straight from here, so rotating one is a
# redeploy. Leave them blank to run the demo without filing: it boots and warns.
NAV_TECH_PASSWORD=
NAV_SIGN_KEY=
# `nav.exchange_key` must be exactly 16 bytes (saas-nav/src/crypto.rs:50).
NAV_EXCHANGE_KEY=

# Which NAV system to file into comes from DEPLOYMENT_ENV above. This is the explicit
# endpoint that overrides it, for a host that flag cannot name. Normally unset.
#NAV_BASE_URL=

# The `nav.software_*` block is compiled in, as `setting_default` calls in src/main.rs. Those
# sit *below* this file, so a NAV_SOFTWARE_* variable here does override them — which is the
# whole difference from the rows this used to seed.

# Barion payment gateway. Which Barion environment is DEPLOYMENT_ENV above; these two are the
# credentials, and both resolve straight from here on every boot, so nothing is stored and
# rotating the POS key is a redeploy. The accepted trade-off: a live payment credential is then
# visible in `docker inspect` and /proc/<pid>/environ.
# PAYMENT_BARION_POS_KEY also gates registration: `main.rs` registers the gateway only when it
# is set, that being the one composition-time signal that a gateway exists, because the
# extension map is frozen before any credential can be read. Leave it blank to run the demo
# without a gateway: no card button, and an invoice reaches PAID through bank transfer and an
# operator's `POST /api/admin/payments`.
# The shop's Barion account e-mail — every transaction names it as the payee.
PAYMENT_BARION_PAYEE=
PAYMENT_BARION_POS_KEY=

# How long a card payment stays open before the gateway expires it, and so how long a payer who
# closed the tab leaves the invoice locked. Also what the SPA counts down. Declared by
# saas-billing, not the adapter, so a second gateway honours it too. Normally unset (10).
#PAYMENT_WINDOW_MINUTES=10

# --- 3. This application's own keys ---------------------------------------------
# The framework never reads them. `dist_dir` is a declared setting this application resolves
# from here, because the router is assembled before any `App` exists. The SELLER_* values seed
# the seller's first published version and are ignored on every later boot — after that,
# PATCH /api/seller/draft.

# Where `pnpm build` in ../frontend puts the SPA.
DIST_DIR=../frontend/dist

# All required: they land on numbered, immutable invoices and in the NAV `supplierAddress`,
# where a placeholder cannot be corrected afterwards. The backend refuses to boot without them.
# The tax number is 11 digits — 8-digit taxpayer id, VAT-code digit, county code — and its
# first 8 digits go into every NAV request's `<user><taxNumber>`; a mismatch is
# `NOT_REGISTERED_CUSTOMER`, whatever the keys say. Punctuation is stripped.
SELLER_TAX_NUMBER=
SELLER_NAME=
SELLER_POSTCODE=
SELLER_CITY=
SELLER_STREET=
# Optional: an invoice without a bank account is legal, one with a wrong one is not.
SELLER_BANK_ACCOUNT=
SELLER_BANK_NAME=
# Optional: not every company has one. Left blank, the seller simply has no EU VAT id.
SELLER_EU_VAT_ID=

# Onto sellers.nav_login by src/seed.rs — a column, not a setting.
NAV_LOGIN=
