# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so no real value and no
# credential ever belongs here.

# 32 random bytes, base64. Generate one:
#   head -c 32 /dev/urandom | base64
MASTER_KEY=
# Relative to the process, not to this file: run `cargo run -p example-backend` from
# `example/backend` (as `start.sh` does), or these land outside the repo.
DB_PATH=./data/example.db
DATA_DIR=./data
LISTEN=127.0.0.1:8080
BASE_URL=http://localhost:8080
# Where `pnpm build` in ../frontend puts the SPA.
DIST_DIR=../frontend/dist

# Mail. Everything but the password is a `settings` row resolved from `SAAS_<KEY>`; the
# password is a secret, seeded once into the encrypted `secrets` table at boot.
# The default `./templates/email` resolves against the backend's cwd (example/backend), where
# there are no templates — `check_email_settings` refuses to boot on it. The repo root's are
# two levels up; `start.sh` exports the same path absolute.
SAAS_EMAIL_TEMPLATE_DIR=../../templates/email
SAAS_EMAIL_FROM=noreply@example.com
SAAS_EMAIL_SMTP_HOST=smtp.example.com
SAAS_EMAIL_SMTP_PORT=587
SAAS_EMAIL_SMTP_USERNAME=noreply@example.com
SAAS_EMAIL_SMTP_TLS_MODE=starttls
SMTP_PASSWORD=

# Where ALERT_SWEEP mails A-NAV-REJECTED and friends. Empty disables alert mail entirely.
SAAS_ADMIN_ALERT_EMAIL=

# --- The seller ------------------------------------------------------------------
# All required: they land on numbered, immutable invoices and in the NAV `supplierAddress`,
# where a placeholder cannot be corrected afterwards. The backend refuses to boot without them.
# The tax number is 11 digits — 8-digit taxpayer id, VAT-code digit, county code — and its
# first 8 digits go into every NAV request's `<user><taxNumber>`; a mismatch is
# `NOT_REGISTERED_CUSTOMER`, whatever the keys say. Punctuation is stripped.
SELLER_TAX_NUMBER=
SELLER_NAME=
SELLER_POSTCODE=
SELLER_CITY=
SELLER_STREET=
# Optional: an invoice without a bank account is legal, one with a wrong one is not.
SELLER_BANK_ACCOUNT=
SELLER_BANK_NAME=
# Optional: not every company has one. Left blank, the seller simply has no EU VAT id.
SELLER_EU_VAT_ID=

# --- NAV Online Számla ----------------------------------------------------------
# Seeded by src/seed.rs: NAV_LOGIN onto sellers.nav_login, the three keys into the
# encrypted `secrets` table. Secrets do not resolve from SAAS_* — only `settings` do —
# which is why these are plain names and not SAAS_NAV_*. Leave them blank to run the demo
# without filing: it boots and warns.
# The `nav.software_*` block is compiled in (src/seed.rs, `NAV_SOFTWARE`) — it identifies this
# program, not this deployment, so there is nothing to set here.
NAV_LOGIN=
NAV_TECH_PASSWORD=
NAV_SIGN_KEY=
# `nav.exchange_key` must be exactly 16 bytes (saas-nav/src/crypto.rs:50).
NAV_EXCHANGE_KEY=

# A `settings` row, resolved from the environment as SAAS_ + key uppercased with `.` -> `_`.
# The one NAV setting that differs per deployment, and it has no default on purpose: nothing
# should file production invoices into the test endpoint by accident. Production is
# https://api.onlineszamla.nav.gov.hu/invoiceService/v3
SAAS_NAV_BASE_URL=https://api-test.onlineszamla.nav.gov.hu/invoiceService/v3
