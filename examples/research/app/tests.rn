// SPDX-License-Identifier: MIT-0
//! `mintworks test examples/research/app` (built with `--features ai`).
//!
//! Every route over the fake LLM and search providers `main.rn` selects with `app.test_default`.

const URL = "https://example.org/vat";

async fn req(s, method, path, body) {
	test::request(method, path, Some(`${s.token}`), body).await
}

/// The run's whole SSE stream: the route ends it after the final `done`/`error`.
async fn run_events(s, run) {
	let r = req(s, "GET", `/api/agent/runs/${run}/events`, ()).await?;
	assert_eq!(r.status, 200);
	Ok(r.text)
}

/// The `src_…` a `fetch` tool result carried.
fn source_uid(text) {
	let after = text.split("\"source\":\"").collect::<Vec>();
	let id = after[1].split("\"").collect::<Vec>();
	`${id[0]}`
}

/// A thread whose first run searched, fetched `URL` and answered; returns `(thread, src)`.
async fn researched(s) {
	test::search_fixture(#{
		searches: [[#{ title: "VAT rates", url: URL, snippet: "27% standard" }]],
		pages: [#{ url: URL, title: "VAT rates", text: "The standard rate is 27%." }],
	})?;
	test::llm_script([
		#{ toolCalls: [#{ id: "c1", name: "web_search", arguments: `{"query":"vat rate"}` }] },
		#{ toolCalls: [#{ id: "c2", name: "fetch", arguments: `{"url":"${URL}"}` }] },
		"The standard rate is 27%.",
	])?;
	let r = req(s, "POST", "/api/app/threads", #{ question: "What is the VAT rate?" }).await?;
	assert_eq!(r.status, 201);
	let thread = `${r.body.thread}`;
	let text = run_events(s, `${r.body.run}`).await?;
	assert!(text.contains("\"status\":\"done\""));
	Ok((thread, source_uid(text)))
}

/// A follow-up run that writes `body` as `vat.md` to `space`; returns the run's event stream.
async fn write_note(s, thread, space, body) {
	let args = `{"space":"${space}","path":"vat.md","body":"${body}"}`;
	test::llm_script([
		#{ toolCalls: [#{ id: "c3", name: "memory_write", arguments: args }] },
		"Saved.",
	])?;
	let r = req(s, "POST", `/api/app/threads/${thread}/runs`, #{ input: "save it" }).await?;
	assert_eq!(r.status, 201);
	run_events(s, `${r.body.run}`).await
}

const WRITE_OK = "\"name\":\"memory_write\",\"ok\":true";

/// A follow-up run that saves `body` as `vat.md` in the global space.
async fn save_note(s, thread, body) {
	let text = write_note(s, thread, "notebook:main", body).await?;
	assert!(text.contains(WRITE_OK));
	Ok(())
}

async fn new_project(s, name) {
	let r = req(s, "POST", "/api/app/projects", #{ name }).await?;
	assert_eq!(r.status, 201);
	Ok(`${r.body.uid}`)
}

/// A thread in `project` whose first run just answers; returns its uid.
async fn project_thread(s, project) {
	test::llm_script(["ok"])?;
	let r = req(s, "POST", "/api/app/threads", #{ question: "q", project }).await?;
	assert_eq!(r.status, 201);
	run_events(s, `${r.body.run}`).await?;
	Ok(`${r.body.thread}`)
}

async fn paths(s, space) {
	let r = req(s, "GET", `/api/app/notebook/${space}`, ()).await?;
	assert_eq!(r.status, 200);
	let out = [];
	for d in r.body {
		out.push(`${d.path}`);
	}
	Ok(out)
}

#[test]
pub async fn a_thread_is_listed_with_its_question_as_title() {
	let s = test::session()?;
	let (thread, _src) = researched(s).await?;

	let r = req(s, "GET", "/api/app/threads", ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.len(), 1);
	assert_eq!(r.body[0].uid, thread);
	assert_eq!(r.body[0].title, "What is the VAT rate?");
}

fn digits(n) {
	let s = "";
	for _ in 0..n {
		s = `${s}0123456789`;
	}
	s
}

#[test]
pub async fn a_long_question_is_truncated_to_80_chars_for_the_title() {
	let s = test::session()?;
	test::llm_script(["ok"])?;
	let q = digits(10);
	let r = req(s, "POST", "/api/app/threads", #{ question: q }).await?;
	assert_eq!(r.status, 201);
	run_events(s, `${r.body.run}`).await?;

	let r = req(s, "GET", "/api/app/threads", ()).await?;
	assert_eq!(r.body[0].title, digits(8));
}

#[test]
pub async fn a_blank_or_missing_question_is_400() {
	let s = test::session()?;
	let r = req(s, "POST", "/api/app/threads", #{ question: "  " }).await?;
	assert_eq!(r.status, 400);
	let r = req(s, "POST", "/api/app/threads", #{}).await?;
	assert_eq!(r.status, 400);
}

#[test]
pub async fn messages_hide_tool_output_but_keep_the_calls() {
	let s = test::session()?;
	let (thread, _src) = researched(s).await?;

	let r = req(s, "GET", `/api/app/threads/${thread}/messages`, ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body[0].role, "user");
	assert_eq!(r.body[0].content, "What is the VAT rate?");
	assert_eq!(r.body[1].toolCalls[0].name, "web_search");
	assert_eq!(r.body[1].toolCalls[0].arguments, `{"query":"vat rate"}`);
	let tools = 0;
	for m in r.body {
		if m.role == "tool" {
			assert_eq!(m.content, "");
			tools += 1;
		}
	}
	assert_eq!(tools, 2);
	let last = r.body[r.body.len() - 1];
	assert_eq!(last.content, "The standard rate is 27%.");
}

#[test]
pub async fn another_org_sees_no_thread() {
	let s = test::session()?;
	let (thread, _src) = researched(s).await?;
	let b = `${s.tokenB}`;

	let r = test::request("GET", `/api/app/threads/${thread}/messages`, Some(`${b}`), ()).await?;
	assert_eq!(r.status, 404);
	let r = test::request("POST", `/api/app/threads/${thread}/runs`, Some(`${b}`), #{
		input: "x",
	}).await?;
	assert_eq!(r.status, 404);
	let r = test::request("GET", "/api/app/threads", Some(`${b}`), ()).await?;
	assert_eq!(r.body.len(), 0);
}

#[test]
pub async fn a_source_resolves_to_title_and_url() {
	let s = test::session()?;
	let (_thread, src) = researched(s).await?;

	let r = req(s, "GET", `/api/app/sources/${src}`, ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.title, "VAT rates");
	assert_eq!(r.body.url, URL);
}

#[test]
pub async fn the_notebook_lists_reads_and_versions_a_saved_doc() {
	let s = test::session()?;
	let r = req(s, "GET", "/api/app/notebook/global", ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.len(), 0);

	let (thread, src) = researched(s).await?;
	save_note(s, `${thread}`, `Standard rate: 27% [${src}].`).await?;

	let r = req(s, "GET", "/api/app/notebook/global", ()).await?;
	assert_eq!(r.body.len(), 1);
	assert_eq!(r.body[0].path, "vat.md");
	let r = req(s, "GET", "/api/app/notebook/global/vat.md", ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.body, `Standard rate: 27% [${src}].`);
	let r = req(s, "GET", "/api/app/notebook/global/vat.md?version=1", ()).await?;
	assert_eq!(r.body.version, 1);
	let r = req(s, "GET", "/api/app/notebook/global/vat.md?version=x", ()).await?;
	assert_eq!(r.status, 400);
	let r = req(s, "GET", "/api/app/notebook/global/vat.md/history", ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.len(), 1);
	let r = req(s, "GET", "/api/app/notebook/global/nope.md", ()).await?;
	assert_eq!(r.status, 404);
}

#[test]
pub async fn the_pdf_numbers_citations_and_appends_sources() {
	let s = test::session()?;
	let (thread, src) = researched(s).await?;
	save_note(s, `${thread}`, `27% [${src}]. Again [${src}]. Unknown [src_nope].`).await?;

	let r = req(s, "POST", "/api/app/notebook/global/vat.md/pdf", ()).await?;
	assert_eq!(r.status, 201);
	assert!(`${r.body.uid}`.starts_with("doc_"));
	let md = `${r.body.markdown}`;
	assert!(md.starts_with("27% [1]. Again [1]. Unknown [src_nope]."));
	assert!(md.contains("## Sources"));
	assert!(md.contains(`1. VAT rates — ${URL}`));

	let r = req(s, "GET", `/api/documents/${r.body.uid}`, ()).await?;
	assert_eq!(r.status, 200);
}

#[test]
pub async fn usage_reports_the_org_budget_once_a_thread_exists() {
	let s = test::session()?;
	let r = req(s, "GET", "/api/app/usage", ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.spent, 0);
	assert!(match r.body.budget { () => true, _ => false });

	researched(s).await?;
	let r = req(s, "GET", "/api/app/usage", ()).await?;
	assert_eq!(r.body.budget, 1000000);
}

#[test]
pub async fn projects_are_created_and_listed() {
	let s = test::session()?;
	let r = req(s, "POST", "/api/app/projects", #{ name: " " }).await?;
	assert_eq!(r.status, 400);
	let p = new_project(s, "Tax").await?;
	assert!(p.starts_with("prj_"));
	let r = req(s, "GET", "/api/app/projects", ()).await?;
	assert_eq!(r.body.len(), 1);
	assert_eq!(r.body[0].uid, p);
	assert_eq!(r.body[0].name, "Tax");
}

#[test]
pub async fn a_project_thread_saves_to_its_project_space() {
	let s = test::session()?;
	let p = new_project(s, "Tax").await?;
	let thread = project_thread(s, `${p}`).await?;
	let text = write_note(s, thread, `project:${p}`, "note").await?;
	assert!(text.contains(WRITE_OK));
	assert_eq!(paths(s, `${p}`).await?, ["vat.md"]);
	assert_eq!(paths(s, "global").await?.len(), 0);
}

#[test]
pub async fn a_thread_without_project_cannot_write_a_project_space() {
	let s = test::session()?;
	let p = new_project(s, "Tax").await?;
	let (thread, _src) = researched(s).await?;
	let text = write_note(s, thread, `project:${p}`, "note").await?;
	assert!(text.contains("\"name\":\"memory_write\",\"ok\":false"));
	assert_eq!(paths(s, `${p}`).await?.len(), 0);
}

#[test]
pub async fn a_report_lands_in_the_reports_space() {
	let s = test::session()?;
	let p = new_project(s, "Tax").await?;
	let thread = project_thread(s, `${p}`).await?;
	let text = write_note(s, thread, `reports:${p}`, "report").await?;
	assert!(text.contains(WRITE_OK));
	assert_eq!(paths(s, `reports-${p}`).await?, ["vat.md"]);
	assert_eq!(paths(s, `${p}`).await?.len(), 0);

	let r = req(s, "POST", `/api/app/notebook/reports-${p}/vat.md/pdf`, ()).await?;
	assert_eq!(r.status, 201);
}

#[test]
pub async fn an_unknown_project_is_notfound() {
	let s = test::session()?;
	let r = req(s, "POST", "/api/app/threads", #{ question: "q", project: "prj_nope" }).await?;
	assert_eq!(r.status, 404);
	let r = req(s, "GET", "/api/app/notebook/prj_nope", ()).await?;
	assert_eq!(r.status, 404);
	let r = req(s, "GET", "/api/app/notebook/reports-prj_nope", ()).await?;
	assert_eq!(r.status, 404);
}

#[test]
pub async fn another_org_cannot_read_a_project_notebook() {
	let s = test::session()?;
	let p = new_project(s, "Tax").await?;
	let b = `${s.tokenB}`;
	let r = test::request("GET", `/api/app/notebook/${p}`, Some(`${b}`), ()).await?;
	assert_eq!(r.status, 404);
}

#[test]
pub async fn threads_list_carries_the_project() {
	let s = test::session()?;
	let p = new_project(s, "Tax").await?;
	let thread = project_thread(s, `${p}`).await?;
	researched(s).await?;

	let r = req(s, "GET", "/api/app/threads", ()).await?;
	assert_eq!(r.body.len(), 2);
	for t in r.body {
		if t.uid == thread {
			assert_eq!(t.project, p);
		} else {
			assert!(match t.project { () => true, _ => false });
		}
	}
}

