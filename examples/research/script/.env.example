# The research app's environment. Copy to `.env` (gitignored) and fill in. Run `saas-run` from
# the **repository root**, which is what the relative paths below resolve against.
#
# An unprefixed SCREAMING_SNAKE name is a framework key — the declared key uppercased with `.`
# and `-` replaced by `_`. A blank value means *absent*.

# --- Process bootstrap ----------------------------------------------------------
# 32 random bytes, base64 — never auto-generated:  head -c 32 /dev/urandom | base64
MASTER_KEY=
# Its own database, separate from the other examples'.
DB_PATH=./data/research.db
DATA_DIR=./data/research
LISTEN=127.0.0.1:8083
BASE_URL=http://localhost:8083
# The SPA; app-dir relative, not process relative. Build `../frontend` first.
DIST_DIR=../frontend/dist

# --- Framework keys -------------------------------------------------------------
# `email.from` and `email.smtp.host` are `.required()`: activation mail goes through them.
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_TLS_MODE=
EMAIL_SMTP_PASSWORD=
# `test` means the providers' real sandboxes, never fakes; fakes exist only in `saas-run test`.
DEPLOYMENT_ENV=test

# DeepSeek, the `research` profile's provider (`llm.api_key.deepseek`).
LLM_API_KEY_DEEPSEEK=
# Jina search; the fetcher is already Jina by default. Reader fetch works keyless, search may not.
SEARCH_PROVIDER=jina
SEARCH_API_KEY_JINA=
