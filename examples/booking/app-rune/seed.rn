// SPDX-License-Identifier: MIT-0
//! Boot-time seeding, run from `on_init` on every start and therefore idempotent.
//!
//! The init ctx is bound to the deployment's **root** org, never to an acting one. What is
//! seeded here is what a child org inherits by climbing `orgs.parent_id`: the `sellers` row, its
//! published version and the service catalogue.
//!
//! Legal documents are **not** seeded here. `mintworks` publishes `<app-dir>/legal/*.md` itself,
//! versioned by the file's own digest — there is no `AuthStore` binding, and publishing a legal
//! document is a deployment act rather than business logic.

pub async fn seed(ctx) {
	// Minting a `sellers` row is a grant, not an org-admin operation: `put_seller` has no
	// service wrapper and no HTTP route, and from script it is reachable only here — any other
	// actor gets `E-SCRIPT-INIT-ONLY`.
	invoices::put_seller(ctx, #{
		seriesCode: env_req("APP_SELLER_SERIES_CODE")?,
		// Blank on purpose: it falls back to `settings['nav.base_url']`, so a deployment's NAV
		// endpoint stays configuration instead of being baked into the row.
		navBaseUrl: "",
		navLogin: env_opt("APP_NAV_LOGIN"),
	}).await?;

	// The statutory half, re-read on every boot. `sync_seller` publishes a version only when the
	// merged row differs from the live one, so an unchanged config stacks nothing and a changed
	// one takes effect; it refuses rather than clobbering an operator's open draft.
	invoices::sync_seller(ctx, #{
		name: env_req("APP_SELLER_NAME")?,
		country: "HU",
		taxNumber: env_req("APP_SELLER_TAX_NUMBER")?,
		postcode: env_req("APP_SELLER_POSTCODE")?,
		city: env_req("APP_SELLER_CITY")?,
		street: env_req("APP_SELLER_STREET")?,
		bankAccount: env_req("APP_SELLER_BANK_ACCOUNT")?,
		bankName: env_req("APP_SELLER_BANK_NAME")?,
	}).await?;

	// The two catalogue rows `../app-rust/src/seed.rs` seeds, at the same prices.
	// `sync_services` upserts by `code`, so editing a price here is an update and never a
	// second row.
	invoices::sync_services(ctx, [
		#{ code: "CONSULT", name: "Tanácsadás", description: (), unit: "hour",
		   unitPrice: money("15000.00", "HUF")?, vatCode: "STD27" },
		#{ code: "SITEVISIT", name: "Helyszíni kiszállás", description: (), unit: "occasion",
		   unitPrice: money("25000.00", "HUF")?, vatCode: "STD27" },
	]).await?
}
