//! `mintworks test examples/subscription/app`.

async fn grant_credits(s, amount) {
	let r = test::request("POST", `/api/admin/orgs/${s.orgUid}/grants`, Some(`${s.token}`), #{
		key: "ai_credits",
		amount,
	}).await?;
	assert_eq!(r.status, 201);
	Ok(())
}

async fn spend(s, idem) {
	test::request("POST", "/api/demo/generate", Some(`${s.token}`), #{ idem: idem }).await
}

#[test]
pub async fn consume_until_exhausted() {
	let s = test::session()?;
	grant_credits(s, 20).await?;

	let r = spend(s, "a").await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.balance, 10);
	let r = spend(s, "b").await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.balance, 0);

	let r = spend(s, "c").await?;
	assert_eq!(r.status, 402);
	assert_eq!(r.body.error.errCode, "E-ENT-EXHAUSTED");
}

#[test]
pub async fn retried_idem_debits_once() {
	let s = test::session()?;
	grant_credits(s, 20).await?;

	assert_eq!(spend(s, "same").await?.body.balance, 10);
	assert_eq!(spend(s, "same").await?.body.balance, 10);
}

#[test]
pub async fn summary_lists_the_meter() {
	let s = test::session()?;
	grant_credits(s, 30).await?;

	let r = test::request("GET", "/api/entitlements", Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.meters.ai_credits.balance, 30);
	assert_eq!(r.body.features.len(), 0);
}

// ---------------------------------------------------------------- offers and plans

/// `YYYY-MM-DDTHH:MM:SSZ` → unix seconds (days-from-civil). Rune has no clock or date parser,
/// and `/api/demo/renew` takes the sweep's time as an integer.
fn unix_of(iso) {
	let s = `${iso}`;
	let y = s[0..4].parse::<i64>()?;
	let m = s[5..7].parse::<i64>()?;
	let d = s[8..10].parse::<i64>()?;
	let secs = s[11..13].parse::<i64>()? * 3600 + s[14..16].parse::<i64>()? * 60
		+ s[17..19].parse::<i64>()?;
	if m <= 2 {
		y -= 1;
	}
	let era = y / 400;
	let yoe = y - era * 400;
	let mp = if m > 2 { m - 3 } else { m + 9 };
	let doy = (153 * mp + 2) / 5 + d - 1;
	let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
	Ok((era * 146097 + doe - 719468) * 86400 + secs)
}

const DAY = 86400;

fn meter_balance(body, key) {
	match body.meters.get(key) {
		Some(m) => m.balance,
		None => 0,
	}
}

fn has_feature(body, key) {
	for f in body.features {
		if f == key {
			return true;
		}
	}
	false
}

/// Grants, recurrence refs and rewards are written by event handlers on their own tasks, so a
/// read straight after a payment can precede them: re-read until `done(body)`, then hand back.
async fn entitlements_when(token, done) {
	let i = 0;
	loop {
		let r = test::request("GET", "/api/entitlements", Some(`${token}`), ()).await?;
		if done(r.body) || i >= 500 {
			return Ok(r.body);
		}
		i += 1;
	}
}

async fn buyer_party(s) {
	let r = test::request("POST", "/api/billing-parties", Some(`${s.token}`), #{
		kind: "C",
		name: "Vevő Kft.",
		taxNumber: "87654321-2-42",
		country: "HU",
		postcode: "1052",
		city: "Budapest",
		street: "Deák tér 2.",
		isDefault: true,
	}).await?;
	assert_eq!(r.status, 201);
	Ok(())
}

async fn quote(s, req) {
	let r = test::request("POST", "/api/plans/quote", Some(`${s.token}`), req).await?;
	assert_eq!(r.status, 200);
	Ok(r.body)
}

async fn checkout(s, q, method) {
	let r = test::request("POST", "/api/plans/checkout", Some(`${s.token}`), #{
		quoteToken: q.quoteToken,
		payMethod: method,
	}).await?;
	assert_eq!(r.status, 200);
	Ok(r.body)
}

/// A received transfer, recorded by the operator against one issued invoice.
async fn pay_transfer(s, invoice_uid, gross) {
	let r = test::request("POST", "/api/admin/payments", Some(`${s.token}`), #{
		orgUid: `${s.orgUid}`,
		kind: "TRANSFER",
		amount: gross,
		receivedAt: "2026-09-29T00:00:00Z",
		allocations: [#{ invoiceUid: `${invoice_uid}`, amount: gross }],
	}).await?;
	assert_eq!(r.status, 201);
	Ok(r.body)
}

/// The draft paid through the scripted `fake` gateway, which settles on `start`.
async fn pay_card(s, invoice_uid) {
	test::payments([#{ state: "Succeeded" }])?;
	let r = test::request("POST", `/api/invoices/${invoice_uid}/pay`, Some(`${s.token}`), #{
		provider: "fake",
		returnUrl: "/return",
	}).await?;
	assert!(r.status < 300, "pay answered {}", r.status);
	Ok(r.body)
}

async fn subscription(s) {
	let r = test::request("GET", "/api/plans/subscriptions", Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	Ok(r.body.items[0])
}

async fn renew_at(s, at) {
	let r = test::request("POST", "/api/demo/renew", Some(`${s.token}`), #{ at: at }).await?;
	assert_eq!(r.status, 200);
	Ok(())
}

#[test]
pub async fn one_time_purchase_by_transfer_grants_credits() {
	let s = test::session()?;
	buyer_party(s).await?;
	let q = quote(s, #{ offer: "credits_1000" }).await?;
	let c = checkout(s, q, "TRANSFER").await?;
	assert_eq!(c.next, "issued");

	pay_transfer(s, c.invoiceUid, q.gross).await?;
	let e = entitlements_when(s.token, |b| meter_balance(b, "ai_credits") == 1000).await?;
	assert_eq!(meter_balance(e, "ai_credits"), 1000);
}

#[test]
pub async fn refund_cuts_the_purchase() {
	let s = test::session()?;
	buyer_party(s).await?;
	let c = checkout(s, quote(s, #{ offer: "credits_1000" }).await?, "CARD").await?;
	assert_eq!(c.next, "pay");
	let paid = pay_card(s, c.invoiceUid).await?;
	entitlements_when(s.token, |b| meter_balance(b, "ai_credits") == 1000).await?;

	let r = test::request("POST", `/api/admin/payments/${paid.payment.uid}/refund`, Some(`${s.token}`),
		#{ reason: "demo" }).await?;
	assert!(r.status < 300, "refund answered {}", r.status);
	let e = entitlements_when(s.token, |b| meter_balance(b, "ai_credits") == 0).await?;
	assert_eq!(meter_balance(e, "ai_credits"), 0);
}

#[test]
pub async fn card_subscription_renews_by_recurring_charge() {
	let s = test::session()?;
	buyer_party(s).await?;
	let c = checkout(s, quote(s, #{ offer: "team" }).await?, "CARD").await?;
	assert_eq!(c.next, "pay");
	pay_card(s, c.invoiceUid).await?;
	let sub = subscription(s).await?;
	assert_eq!(sub.status, "ACTIVE");
	// Settled: the provisional grant is extended to the period end, and the recurrence stored.
	let e = entitlements_when(s.token, |b| match b.meters.get("ai_credits") {
		// `()` until the async `PaymentSettled` handler lands; `() == String` raises in Rune.
		Some(m) => match m.nextExpiry {
			() => false,
			x => x == sub.periodEnd && has_feature(b, "export"),
		},
		None => false,
	}).await?;
	assert!(has_feature(e, "export"));

	test::payments([#{ state: "Succeeded" }])?;
	renew_at(s, unix_of(sub.periodEnd)?).await?;
	let renewed = subscription(s).await?;
	assert_eq!(renewed.periodStart, sub.periodEnd);
	assert_eq!(renewed.status, "ACTIVE");
	let p = test::request("GET", "/api/payments", Some(`${s.token}`), ()).await?;
	assert_eq!(p.body.items.len(), 2, "the renewal was charged against the stored recurrence");
}

#[test]
pub async fn unpaid_renewal_goes_past_due_then_suspended() {
	let s = test::session()?;
	buyer_party(s).await?;
	let q = quote(s, #{ offer: "team" }).await?;
	let c = checkout(s, q, "TRANSFER").await?;
	pay_transfer(s, c.invoiceUid, q.gross).await?;
	let end = unix_of(subscription(s).await?.periodEnd)?;

	renew_at(s, end).await?;
	assert_eq!(subscription(s).await?.status, "ACTIVE", "inside the grace days");
	// `plans.grace_days` 3: the renewal's provisional grants lapse with the grace window.
	renew_at(s, end + 4 * DAY).await?;
	assert_eq!(subscription(s).await?.status, "PAST_DUE");
	// `plans.suspend_after_days` 14.
	renew_at(s, end + 15 * DAY).await?;
	assert_eq!(subscription(s).await?.status, "SUSPENDED");
}

#[test]
pub async fn cancel_at_period_end_stops_the_renewal() {
	let s = test::session()?;
	buyer_party(s).await?;
	let q = quote(s, #{ offer: "storage" }).await?;
	let c = checkout(s, q, "TRANSFER").await?;
	pay_transfer(s, c.invoiceUid, q.gross).await?;
	let sub = subscription(s).await?;

	let r = test::request("POST", `/api/plans/subscriptions/${sub.uid}/cancel`, Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert!(r.body.cancelAtPeriodEnd);
	renew_at(s, unix_of(sub.periodEnd)?).await?;
	assert_eq!(subscription(s).await?.status, "CANCELED");
}

/// A paid TRANSFER `team` subscription, one seat.
async fn paid_team(s) {
	let q = quote(s, #{ offer: "team" }).await?;
	let c = checkout(s, q, "TRANSFER").await?;
	pay_transfer(s, c.invoiceUid, q.gross).await?;
	subscription(s).await
}

#[test]
pub async fn seat_upgrade_invoices_the_rest_of_the_period_now() {
	let s = test::session()?;
	buyer_party(s).await?;
	let sub = paid_team(s).await?;

	let up = quote(s, #{ offer: "team", qty: 2, subscription: `${sub.uid}` }).await?;
	assert_eq!(up.effective, "now");
	assert!(up.gross.amount != "0.00");
	let c = checkout(s, up, "TRANSFER").await?;
	assert_eq!(c.next, "issued");
	let after = subscription(s).await?;
	assert_eq!(after.qty, 2);
	assert_eq!(after.periodEnd, sub.periodEnd);
}

#[test]
pub async fn downgrade_waits_for_the_period_end() {
	let s = test::session()?;
	buyer_party(s).await?;
	let sub = paid_team(s).await?;

	let down = quote(s, #{ offer: "pro", subscription: `${sub.uid}` }).await?;
	assert_eq!(down.effective, "period_end");
	assert_eq!(down.gross.amount, "0.00");
	let c = checkout(s, down, "TRANSFER").await?;
	assert_eq!(c.next, "scheduled");
	assert_eq!(subscription(s).await?.nextQty, 1);

	renew_at(s, unix_of(sub.periodEnd)?).await?;
	let after = subscription(s).await?;
	assert_eq!(after.price, "4990.00");
	assert_eq!(after.nextQty, ());
}

#[test]
pub async fn trial_needs_no_invoice_then_renews() {
	let s = test::session()?;
	buyer_party(s).await?;
	let c = checkout(s, quote(s, #{ offer: "pro" }).await?, "TRANSFER").await?;
	assert_eq!(c.next, "trialing");
	let sub = subscription(s).await?;
	assert_eq!(sub.status, "TRIALING");
	let e = entitlements_when(s.token, |b| has_feature(b, "export")).await?;
	assert!(has_feature(e, "export"));

	renew_at(s, unix_of(sub.periodEnd)?).await?;
	assert_eq!(subscription(s).await?.status, "ACTIVE");
	let inv = test::request("GET", "/api/invoices", Some(`${s.token}`), ()).await?;
	assert_eq!(inv.body.items.len(), 1, "the first paid period is the renewal invoice");

	// One trial per family, ever: the next pro quote is full price.
	let again = quote(s, #{ offer: "pro" }).await?;
	assert_eq!(again.net.amount, "4990.00");
}

#[test]
pub async fn card_trial_renews_by_recurring_charge() {
	let s = test::session()?;
	buyer_party(s).await?;
	let c = checkout(s, quote(s, #{ offer: "pro" }).await?, "CARD").await?;
	assert_eq!(c.next, "trialing");
	let sub = subscription(s).await?;

	// No recurrence yet: the first renewal is paid by hand, and that payment starts one.
	renew_at(s, unix_of(sub.periodEnd)?).await?;
	let inv = test::request("GET", "/api/invoices", Some(`${s.token}`), ()).await?;
	assert_eq!(inv.body.items.len(), 1);
	pay_card(s, inv.body.items[0].uid).await?;
	let renewed = subscription(s).await?;
	// The settlement stores the recurrence before it extends the period's grants, so a grant
	// reaching `periodEnd` proves the recurrence; the meter's `nextExpiry` still shows the trial's.
	let path = `/api/admin/orgs/${s.orgUid}/grants`;
	let i = 0;
	loop {
		let r = test::request("GET", path.clone(), Some(`${s.token}`), ()).await?;
		assert_eq!(r.status, 200);
		let hit = false;
		for g in r.body.items {
			if g.validUntil is String && g.validUntil == renewed.periodEnd {
				hit = true;
			}
		}
		if hit {
			break;
		}
		assert!(i < 300, "the settlement never extended the grants");
		i += 1;
	}

	test::payments([#{ state: "Succeeded" }])?;
	renew_at(s, unix_of(renewed.periodEnd)?).await?;
	assert_eq!(subscription(s).await?.periodStart, renewed.periodEnd);
	let p = test::request("GET", "/api/payments", Some(`${s.token}`), ()).await?;
	assert_eq!(p.body.items.len(), 2, "the second period was charged against the recurrence");
}

#[test]
pub async fn coupon_halves_one_period() {
	let s = test::session()?;
	buyer_party(s).await?;
	// Minted by the seller (the root): a buyer's own coupon discounts nothing.
	let r = test::request("POST", "/api/refs", Some(`${s.rootToken}`), #{
		type: "coupon",
		code: "HALFTEAM",
		params: #{ offers: ["team"], discount: #{ percentBp: 5000 }, periods: 1 },
	}).await?;
	assert_eq!(r.status, 201);

	let full = quote(s, #{ offer: "team" }).await?;
	assert_eq!(full.net.amount, "14990.00");
	let half = quote(s, #{ offer: "team", coupon: "HALFTEAM" }).await?;
	assert_eq!(half.net.amount, "7495.00");
	let c = checkout(s, half, "TRANSFER").await?;
	pay_transfer(s, c.invoiceUid, half.gross).await?;

	renew_at(s, unix_of(subscription(s).await?.periodEnd)?).await?;
	assert_eq!(subscription(s).await?.couponPeriodsLeft, 0);
	// Redeemed by this org already.
	let r = test::request("POST", "/api/plans/quote", Some(`${s.token}`),
		#{ offer: "storage", coupon: "HALFTEAM" }).await?;
	assert_eq!(r.status, 422);
	assert_eq!(r.body.error.errCode, "E-PLAN-COUPON-INVALID");
}

#[test]
pub async fn revoked_ref_can_be_reactivated() {
	let s = test::session()?;
	let r = test::request("POST", "/api/refs", Some(`${s.rootToken}`), #{
		type: "coupon",
		code: "COMEBACK",
		params: #{ offers: ["team"], discount: #{ percentBp: 1000 }, periods: 1 },
	}).await?;
	assert_eq!(r.status, 201);
	let (uid, code) = (r.body.uid, r.body.code);

	let r = test::request("DELETE", `/api/refs/${uid}`, Some(`${s.rootToken}`), ()).await?;
	assert_eq!(r.status, 204);
	let r = test::request("GET", `/api/refs/${code}`, None, ()).await?;
	assert!(!r.body.valid, "revoked");

	let r = test::request("POST", `/api/refs/${uid}/reactivate`, Some(`${s.rootToken}`), ())
		.await?;
	assert_eq!(r.status, 204);
	let r = test::request("GET", `/api/refs/${code}`, None, ()).await?;
	assert!(r.body.valid, "reactivated");
}

#[test]
pub async fn signup_ref_rewards_both_sides_on_first_payment() {
	let s = test::session()?;
	let r = test::request("POST", "/api/auth/signup-refs", Some(`${s.token}`), #{}).await?;
	assert_eq!(r.status, 201);

	let friend = test::signup(#{ email: "friend@subscription.test", refCode: r.body.code }).await?;
	let r = test::request("GET", "/api/entitlements", Some(`${friend.token}`), ()).await?;
	assert!(!has_feature(r.body, "export"), "activation alone rewards nothing");

	buyer_party(friend).await?;
	let q = quote(friend, #{ offer: "credits_1000" }).await?;
	let c = checkout(friend, q, "TRANSFER").await?;
	pay_transfer(#{ token: s.token, orgUid: friend.orgUid }, c.invoiceUid, q.gross).await?;
	let e = entitlements_when(friend.token, |b| has_feature(b, "export")).await?;
	assert!(has_feature(e, "export"), "the invitee's reward");
	let e = entitlements_when(friend.token, |b| meter_balance(b, "ai_credits") == 2000).await?;
	assert_eq!(meter_balance(e, "ai_credits"), 2000, "the purchase plus the reward");
	let e = entitlements_when(s.token, |b| has_feature(b, "export")).await?;
	assert!(has_feature(e, "export"), "the inviter's reward");
}

/// An app ref type (`teacher_link`) admits a signup only because `params.admits` is set.
async fn teacher_link(s, code) {
	let r = test::request("POST", "/api/refs", Some(`${s.rootToken}`), #{
		type: "teacher_link",
		code,
		params: #{ admits: true },
	}).await?;
	assert_eq!(r.status, 201);
	Ok(r.body)
}

#[test]
pub async fn an_app_ref_type_admits_at_activation() {
	let s = test::session()?;
	let link = teacher_link(s, "TEACH-ANN").await?;
	let pupil = test::signup(#{ email: "pupil@subscription.test", refCode: "TEACH-ANN" }).await?;

	// `AccountActivated` handlers run on their own task: poll for the row.
	let i = 0;
	let row = loop {
		let r = test::request("POST", "/api/demo/activation", Some(`${s.rootToken}`),
			#{ account: pupil.accountUid }).await?;
		if r.body.row is Object || i >= 500 {
			break r.body.row;
		}
		i += 1;
	};
	assert!(row is Object, "the handler ran");
	assert_eq!(row.body.refUid, link.uid);
	Ok(())
}

#[test]
pub async fn refs_redeem_is_fresh_once_per_account() {
	let s = test::session()?;
	let link = teacher_link(s, "TEACH-BOB").await?;
	let a = test::signup(#{ email: "late@subscription.test" }).await?;

	let r = test::request("POST", "/api/demo/redeem", Some(`${a.token}`), #{ code: "TEACH-BOB" })
		.await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.uid, link.uid);
	assert!(!r.body.contains_key("email"), "the ref's own fields stay private");
	assert!(r.body.fresh);
	let r = test::request("POST", "/api/demo/redeem", Some(`${a.token}`), #{ code: "TEACH-BOB" })
		.await?;
	assert_eq!(r.status, 200);
	assert!(!r.body.fresh, "a repeat redeem is not fresh");

	let r = test::request("POST", "/api/demo/redeem", Some(`${a.token}`), #{ code: "NO-SUCH" })
		.await?;
	assert_eq!(r.body.error.errCode, "E-CORE-REF-INVALID");

	// Another type's code, and one bound to another address, read as unknown.
	let r = test::request("POST", "/api/refs", Some(`${s.rootToken}`), #{
		type: "coupon",
		code: "NOT-A-LINK",
		params: #{ offers: ["team"], discount: #{ percentBp: 1000 }, periods: 1 },
	}).await?;
	assert_eq!(r.status, 201);
	let r = test::request("POST", "/api/demo/redeem", Some(`${a.token}`), #{ code: "NOT-A-LINK" })
		.await?;
	assert_eq!(r.body.error.errCode, "E-CORE-REF-INVALID");
	let r = test::request("POST", "/api/refs", Some(`${s.rootToken}`), #{
		type: "teacher_link",
		code: "TEACH-BOUND",
		email: "someone.else@subscription.test",
		params: #{ admits: true },
	}).await?;
	assert_eq!(r.status, 201);
	let r = test::request("POST", "/api/demo/redeem", Some(`${a.token}`), #{ code: "TEACH-BOUND" })
		.await?;
	assert_eq!(r.body.error.errCode, "E-CORE-REF-INVALID");
	Ok(())
}

#[test]
pub async fn an_app_role_sets_its_rank_and_shows_on_the_wire() {
	let a = test::signup(#{ email: "head@subscription.test" }).await?;
	let b = test::signup(#{ email: "teach@subscription.test" }).await?;
	let c = test::signup(#{ email: "stranger@subscription.test" }).await?;
	let r = test::request("POST", "/api/orgs", Some(`${a.token}`), #{ name: "School" }).await?;
	assert_eq!(r.status, 201);
	let school = r.body.uid;
	let r = test::request("POST", "/api/auth/switch-org", Some(`${a.token}`), #{ orgUid: school })
		.await?;
	let owner = r.body.accessToken;
	let r = test::request("POST", "/api/org/members", Some(`${owner}`),
		#{ email: "teach@subscription.test", role: "MEMBER" }).await?;
	assert!(r.status < 300, "invite answered {}", r.status);
	let r = test::request("GET", "/api/org/invites", Some(`${owner}`), ()).await?;
	let code = r.body.items[0].code;
	let r = test::request("POST", `/api/org/invites/${code}/accept`, Some(`${b.token}`), ()).await?;
	assert_eq!(r.status, 204);

	// `a.token` is scoped to the personal org: the explicit `org` is what is checked.
	let r = test::request("POST", "/api/demo/member-role", Some(`${a.token}`),
		#{ org: school, account: b.accountUid, appRole: "teacher" }).await?;
	assert_eq!(r.status, 200);
	let r = test::request("GET", "/api/org/members", Some(`${owner}`), ()).await?;
	let row = r.body.items.iter().find(|m| m.accountUid == b.accountUid).unwrap();
	assert_eq!(row.appRole, "teacher");
	assert_eq!(row.role, "ADMIN", "the app role sets its mapped rank");
	assert!(r.body.items.iter().find(|m| m.accountUid == a.accountUid).unwrap().get("appRole").is_none());
	let r = test::request("GET", "/api/orgs", Some(`${b.token}`), ()).await?;
	let org = r.body.items.iter().find(|o| o.uid == school).unwrap();
	assert_eq!(org.appRole, "teacher");

	let r = test::request("POST", "/api/demo/member-role", Some(`${a.token}`),
		#{ org: school, account: b.accountUid, appRole: "janitor" }).await?;
	assert_eq!(r.body.error.errCode, "E-AUTH-APP-ROLE");
	let r = test::request("POST", "/api/demo/member-role", Some(`${a.token}`),
		#{ org: school, account: a.accountUid, appRole: "student" }).await?;
	assert_eq!(r.body.error.errCode, "E-AUTH-FORBIDDEN", "the owner keeps OWNER");
	let r = test::request("POST", "/api/demo/member-role", Some(`${c.token}`),
		#{ org: school, account: b.accountUid, appRole: "student" }).await?;
	assert_eq!(r.body.error.errCode, "E-CORE-NOTFOUND", "a non-member does not see the org");
	Ok(())
}

#[test]
pub async fn a_class_code_admits_many_and_needs_an_admin() {
	let a = test::signup(#{ email: "class-head@subscription.test" }).await?;
	let b = test::signup(#{ email: "class-one@subscription.test" }).await?;
	let c = test::signup(#{ email: "class-two@subscription.test" }).await?;
	let r = test::request("POST", "/api/orgs", Some(`${a.token}`), #{ name: "Class" }).await?;
	let class = r.body.uid;
	let r = test::request("POST", "/api/demo/invite-code", Some(`${a.token}`),
		#{ org: class, opts: #{ appRole: "student" } }).await?;
	assert_eq!(r.status, 200);
	let code = r.body.code;

	for who in [b, c] {
		let r = test::request("POST", `/api/org/invites/${code}/accept`, Some(`${who.token}`), ())
			.await?;
		assert_eq!(r.status, 204, "an email-less code is not single-use");
		let r = test::request("GET", "/api/orgs", Some(`${who.token}`), ()).await?;
		let org = r.body.items.iter().find(|o| o.uid == class).unwrap();
		assert_eq!(org.appRole, "student");
		assert_eq!(org.role, "MEMBER");
	}
	let d = test::signup(#{ email: "class-three@subscription.test", refCode: code }).await?;
	let r = test::request("GET", "/api/orgs", Some(`${d.token}`), ()).await?;
	assert!(r.body.items.iter().find(|o| o.uid == class).is_some(), "signup redeems it too");

	let r = test::request("POST", "/api/demo/invite-codes", Some(`${a.token}`), #{ org: class })
		.await?;
	assert_eq!(r.body.items.len(), 1);
	let r = test::request("POST", "/api/demo/invite-code", Some(`${b.token}`),
		#{ org: class, opts: #{} }).await?;
	assert_eq!(r.body.error.errCode, "E-AUTH-FORBIDDEN", "a MEMBER mints no code");
	Ok(())
}

#[test]
pub async fn create_org_hangs_under_an_explicit_parent() {
	let a = test::signup(#{ email: "tree-head@subscription.test" }).await?;
	let b = test::signup(#{ email: "tree-admin@subscription.test" }).await?;
	let r = test::request("POST", "/api/orgs", Some(`${a.token}`), #{ name: "School" }).await?;
	let school = r.body.uid;
	let r = test::request("POST", "/api/demo/create-org", Some(`${b.token}`),
		#{ name: "Intruder", parent: school }).await?;
	assert_eq!(r.body.error.errCode, "E-CORE-NOTFOUND", "a non-member does not see the parent");

	// `a.token` is scoped to the personal org: the explicit `parent` is what is checked.
	let r = test::request("POST", "/api/demo/create-org", Some(`${a.token}`),
		#{ name: "Class 1A", parent: school, appRole: "teacher" }).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.role, "OWNER");
	let class = r.body.uid;
	let r = test::request("GET", "/api/orgs", Some(`${a.token}`), ()).await?;
	let row = r.body.items.iter().find(|o| o.uid == class).unwrap();
	assert_eq!((row.role, row.appRole), ("OWNER", "teacher"), "the label keeps the OWNER rank");
	let r = test::request("POST", "/api/demo/create-org", Some(`${a.token}`),
		#{ name: "Class 1B", parent: school, appRole: "janitor" }).await?;
	assert_eq!(r.body.error.errCode, "E-AUTH-APP-ROLE");

	// A school ADMIN administers the class only through the parent link.
	let r = test::request("POST", "/api/demo/invite-code", Some(`${a.token}`),
		#{ org: school, opts: #{ role: "ADMIN", usesLeft: 1 } }).await?;
	let code = r.body.code;
	let r = test::request("POST", `/api/org/invites/${code}/accept`, Some(`${b.token}`), ()).await?;
	assert_eq!(r.status, 204);
	let r = test::request("POST", "/api/demo/invite-code", Some(`${b.token}`),
		#{ org: class, opts: #{} }).await?;
	assert_eq!(r.status, 200, "effective ADMIN is inherited from the parent");
	Ok(())
}

async fn code_for(owner, org, opts) {
	let r = test::request("POST", "/api/demo/invite-code", Some(`${owner.token}`),
		#{ org, opts }).await?;
	Ok(r.body.code)
}

async fn accept(who, code) {
	let r = test::request("POST", `/api/org/invites/${code}/accept`, Some(`${who.token}`), ())
		.await?;
	assert_eq!(r.status, 204);
	Ok(())
}

#[test]
pub async fn membership_facts_reach_the_class_below_the_school() {
	let a = test::signup(#{ email: "facts-head@subscription.test" }).await?;
	let b = test::signup(#{ email: "facts-admin@subscription.test" }).await?;
	let c = test::signup(#{ email: "facts-pupil@subscription.test" }).await?;
	let d = test::signup(#{ email: "facts-member@subscription.test" }).await?;
	let r = test::request("POST", "/api/orgs", Some(`${a.token}`), #{ name: "Facts School" })
		.await?;
	let school = r.body.uid;
	let r = test::request("POST", "/api/demo/create-org", Some(`${a.token}`),
		#{ name: "Facts 1A", parent: school }).await?;
	let class = r.body.uid;
	accept(b, code_for(a, school, #{ role: "ADMIN", usesLeft: 1 }).await?).await?;
	accept(c, code_for(a, class, #{ appRole: "student" }).await?).await?;
	accept(d, code_for(a, school, #{}).await?).await?;

	let r = test::request("POST", "/api/demo/my-orgs", Some(`${b.token}`), #{}).await?;
	let row = r.body.items.iter().find(|o| o.uid == class).unwrap();
	assert_eq!((row.rank, row.parentUid, row.appRole), ("ADMIN", school, ()),
		"the school ADMIN reaches the class, without its app role");
	let r = test::request("POST", "/api/demo/my-orgs", Some(`${d.token}`), #{}).await?;
	assert!(r.body.items.iter().find(|o| o.uid == class).is_none(), "a MEMBER stops at the school");

	let r = test::request("POST", "/api/demo/member-uids", Some(`${b.token}`),
		#{ appRole: "student" }).await?;
	assert_eq!(r.body.items, [c.accountUid]);
	let r = test::request("POST", "/api/demo/members", Some(`${b.token}`), #{ org: class }).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.items.iter().find(|m| m.accountUid == c.accountUid).unwrap().appRole,
		"student");
	let r = test::request("POST", "/api/demo/members", Some(`${c.token}`), #{ org: class }).await?;
	assert_eq!(r.body.error.errCode, "E-AUTH-FORBIDDEN", "a MEMBER lists no members");
	let r = test::request("POST", "/api/demo/members", Some(`${b.token}`), #{}).await?;
	assert_eq!(r.status, 200, "the no-argument form is the active org");
	Ok(())
}

async fn put_setting(who, key, value, at) {
	test::request("POST", "/api/demo/setting-set", Some(`${who.token}`), #{ key, value, at }).await
}

async fn get_setting(who, key, at) {
	let r = test::request("POST", "/api/demo/setting-get", Some(`${who.token}`), #{ key, at })
		.await?;
	assert_eq!(r.status, 200);
	Ok(r.body.value)
}

#[test]
pub async fn each_setting_scope_resolves_along_its_own_chain() {
	let a = test::signup(#{ email: "set-head@subscription.test" }).await?;
	let b = test::signup(#{ email: "set-pupil@subscription.test" }).await?;
	let r = test::request("POST", "/api/orgs", Some(`${a.token}`), #{ name: "Set School" }).await?;
	let school = r.body.uid;
	let r = test::request("POST", "/api/demo/create-org", Some(`${a.token}`),
		#{ name: "Set 1A", parent: school }).await?;
	let class = r.body.uid;
	accept(b, code_for(a, class, #{ appRole: "student" }).await?).await?;

	// Global: the default, and the global level is the operator's to write.
	assert_eq!(get_setting(a, "app.banner", #{}).await?, false);
	let r = put_setting(a, "app.banner", true, #{}).await?;
	assert!(r.body.error.errCode.starts_with("E-AUTH-"), "a user writes no global value");

	// Org: the school's value reaches the class below it, until the class sets its own.
	assert_eq!(get_setting(b, "app.welcome", #{ org: class }).await?.text, "hi");
	assert_eq!(put_setting(a, "app.welcome", #{ text: "school" }, #{ org: school }).await?.status, 200);
	assert_eq!(get_setting(b, "app.welcome", #{ org: class }).await?.text, "school");
	put_setting(a, "app.welcome", #{ text: "class" }, #{ org: class }).await?;
	assert_eq!(get_setting(b, "app.welcome", #{ org: class }).await?.text, "class");
	let r = put_setting(b, "app.welcome", #{ text: "pupil" }, #{ org: class }).await?;
	assert_eq!(r.body.error.errCode, "E-AUTH-FORBIDDEN", "a MEMBER writes no org value");

	// Account: one's own row, through the script and through the self-service route alike.
	put_setting(b, "app.theme", "dark", #{ account: b.accountUid }).await?;
	assert_eq!(get_setting(b, "app.theme", #{ account: b.accountUid }).await?, "dark");
	assert_eq!(get_setting(a, "app.theme", #{ account: a.accountUid }).await?, "light");
	let r = test::request("POST", "/api/demo/setting-get", Some(`${a.token}`),
		#{ key: "app.theme", at: #{ account: b.accountUid } }).await?;
	assert_eq!(r.body.error.errCode, "E-CORE-NOTFOUND", "another account's setting");
	let r = test::request("PUT", "/api/account/settings/app.theme", Some(`${a.token}`),
		#{ value: "blue" }).await?;
	assert_eq!(r.status, 204);
	let r = test::request("GET", "/api/account/settings/app.theme", Some(`${a.token}`), ()).await?;
	assert_eq!(r.body.value, "blue");
	let r = test::request("GET", "/api/account/settings/app.welcome", Some(`${a.token}`), ())
		.await?;
	assert_eq!(r.body.error.errCode, "E-CORE-SETTING", "an org key is not an account setting");

	// OrgAccount: a teacher's per-pupil value inside the class, then the org chain's default.
	assert_eq!(get_setting(b, "app.lesson_len", #{ org: class, account: b.accountUid }).await?, 45);
	put_setting(a, "app.lesson_len", 30, #{ org: class, account: b.accountUid }).await?;
	assert_eq!(get_setting(b, "app.lesson_len", #{ org: class, account: b.accountUid }).await?, 30);
	put_setting(a, "app.lesson_len", (), #{ org: class, account: b.accountUid }).await?;
	assert_eq!(get_setting(b, "app.lesson_len", #{ org: class, account: b.accountUid }).await?, 45);
	Ok(())
}

#[test]
pub async fn a_handle_is_public_unique_and_cleared_by_its_owner() {
	let a = test::signup(#{ email: "handle-a@subscription.test" }).await?;
	let b = test::signup(#{ email: "handle-b@subscription.test" }).await?;
	let r = test::request("PATCH", "/api/account", Some(`${a.token}`), #{ handle: " Alice " })
		.await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.handle, "alice", "trimmed and lowercased");
	let r = test::request("GET", "/api/auth/me", Some(`${a.token}`), ()).await?;
	assert_eq!(r.body.account.handle, "alice");
	let r = test::request("PATCH", "/api/account", Some(`${b.token}`), #{ handle: "ALICE" }).await?;
	assert_eq!(r.body.error.errCode, "E-AUTH-HANDLE-TAKEN", "unique in any case");
	let r = test::request("PATCH", "/api/account", Some(`${b.token}`), #{ handle: "support" })
		.await?;
	assert_eq!(r.body.error.errCode, "E-CORE-SLUG-INVALID", "a reserved handle");

	// Public: anyone reads it for any uid, and never an email or a name with it.
	let r = test::request("POST", "/api/demo/handles", Some(`${b.token}`),
		#{ uids: [a.accountUid, b.accountUid, "not-a-uid"] }).await?;
	assert_eq!(r.body.items.len(), 1, "no handle, no entry");
	assert_eq!(r.body.items[0].uid, a.accountUid);
	assert_eq!(r.body.items[0].handle, "alice");
	assert!(!r.body.items[0].contains_key("email"));

	// Clearing another's handle is the operator's; clearing one's own frees it.
	let r = test::request("POST", "/api/demo/set-handle", Some(`${b.token}`),
		#{ account: a.accountUid, handle: () }).await?;
	assert!(r.body.error.errCode.starts_with("E-AUTH-"), "a user clears no other handle");
	let r = test::request("PATCH", "/api/account", Some(`${a.token}`), #{ handle: () }).await?;
	assert_eq!(r.status, 200);
	let r = test::request("PATCH", "/api/account", Some(`${b.token}`), #{ handle: "alice" }).await?;
	assert_eq!(r.status, 200, "a cleared handle is free again");
	Ok(())
}

#[test]
pub async fn a_required_app_consent_kind_is_recorded_and_not_withdrawable() {
	// `test::signup` accepts every required kind, so `AGE16` is recorded at registration.
	let a = test::signup(#{ email: "consent-a@subscription.test" }).await?;
	let r = test::request("GET", "/api/demo/consents", Some(`${a.token}`), ()).await?;
	assert_eq!(r.status, 200, "the gate passes: every required kind is accepted");
	let age = r.body.items.iter().find(|c| c.kind == "AGE16");
	assert!(age.is_some(), "the app kind is listed");
	assert_eq!(age.unwrap().docVersion, "v1");

	let r = test::request("DELETE", "/api/consents/AGE16", Some(`${a.token}`), ()).await?;
	assert_eq!(r.status, 409, "declared withdrawable: false");
	let r = test::request("DELETE", "/api/consents/NOPE", Some(`${a.token}`), ()).await?;
	assert_eq!(r.body.error.errCode, "E-CORE-VALIDATION", "an undeclared kind");
	Ok(())
}

#[test]
pub async fn a_raw_upload_is_stored_claimed_streamed_and_released() {
	let a = test::signup(#{ email: "blob-a@subscription.test" }).await?;
	let b = test::signup(#{ email: "blob-b@subscription.test" }).await?;
	// `test::request` JSON-encodes the body, so the stored bytes are `"hello blob"`, quotes included.
	let r = test::request("POST", `/api/demo/blob?org=${a.orgUid}`, Some(`${a.token}`), "hello blob")
		.await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.contentType, "application/json");
	assert_eq!(r.body.refs, ["demo:note"]);
	let uid = r.body.uid;
	assert!(uid.starts_with("blb_"));

	let r = test::request("GET", `/api/demo/blob/${uid}`, Some(`${a.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body, "hello blob", "the bytes as uploaded");
	let r = test::request("GET", `/api/demo/blob/${uid}`, Some(`${b.token}`), ()).await?;
	assert_eq!(r.status, 404, "another org's blob");
	let r = test::request("POST", `/api/demo/blob?org=${a.orgUid}`, Some(`${b.token}`), "x").await?;
	assert_eq!(r.status, 404, "storing into another org");

	let r = test::request("POST", `/api/demo/blob/${uid}/release`, Some(`${a.token}`), ()).await?;
	assert_eq!(r.body.refs, []);
	let long = "0123456789012345678901234567890123456789012345678901234567890123456789";
	let r = test::request("POST", `/api/demo/blob?org=${a.orgUid}`, Some(`${a.token}`), long).await?;
	assert_eq!(r.status, 413, "past .max_body(64)");
	Ok(())
}
