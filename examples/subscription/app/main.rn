// SPDX-License-Identifier: MIT-0
//! The subscription demo over `mintworks-plans`/`mintworks-entitle`. `README.md` is how to run it.

pub fn main(app) {
	// `email.*` is `.required()`; a suite has no `.env`, and the harness sends no mail.
	app.test_default("email.from", "noreply@subscription.test");
	app.test_default("email.smtp.host", "localhost");

	app.feature("entitle");
	app.entitlement("export", "feature");
	app.entitlement("seats", "limit");
	app.entitlement("storage", "limit");
	app.entitlement("ai_credits", "meter");
	app.mount("entitle");

	// App membership roles: the name a class shows, and the rank it grants.
	app.member_role("teacher", "ADMIN");
	app.member_role("student", "MEMBER");
	app.post("/api/demo/member-role", member_role);
	app.post("/api/demo/invite-code", invite_code);
	app.post("/api/demo/invite-codes", invite_codes);
	app.post("/api/demo/create-org", create_org);
	app.post("/api/demo/my-orgs", my_orgs);
	app.post("/api/demo/members", members);
	app.post("/api/demo/member-uids", member_uids);

	// Scoped settings, one key per scope, read and written through `settings::`.
	app.setting("app.banner", #{ scope: "global", type: "bool", "default": false });
	app.setting("app.welcome", #{ scope: "org", type: "json", "default": #{ text: "hi" } });
	app.setting("app.theme", #{ scope: "account", type: "text", "default": "light", user: true });
	app.setting("app.lesson_len", #{ scope: "orgAccount", type: "int", "default": 45 });
	app.post("/api/demo/setting-get", setting_get);
	app.post("/api/demo/setting-set", setting_set);
	app.post("/api/demo/handles", handles);
	app.post("/api/demo/set-handle", set_handle);
	app.consent("AGE16", #{ required: true, withdrawable: false });
	app.get("/api/demo/consents", consents);
	// Blobs: a raw upload held by one ref, streamed back with its mime, then released.
	app.post("/api/demo/blob", blob_put).raw().max_body(64);
	app.get("/api/demo/blob/{uid}", blob_get);
	app.post("/api/demo/blob/{uid}/release", blob_release);

	app.feature("invoice");
	app.feature("billing");
	app.feature("plans");
	app.mount("invoice.org_read");
	app.mount("invoice.org_parties");
	app.mount("billing.org");
	// Recording a TRANSFER payment and refunding are the operator's.
	app.mount("billing.operator");
	app.mount("refs");
	app.mount("plans");

	// A `signup` ref rewards both sides with a month of pro once the invitee's org first pays.
	app.setting_default("plans.reward_on", "first_payment");
	app.setting_default("plans.reward.signup.inviter", "reward_month_pro");
	app.setting_default("plans.reward.signup.invitee", "reward_month_pro");

	// The `plan` family: one live subscription per org among these three.
	app.offer("free", #{
		name: "Free", kind: "RECURRING", service: "PLAN", family: "plan", rank: 0,
		interval: "MONTH", prices: #{ HUF: 0 }, entitlements: #{ seats: 1 },
	});
	app.offer("pro", #{
		name: "Pro", kind: "RECURRING", service: "PLAN", family: "plan", rank: 1,
		interval: "MONTH", trialDays: 14, prices: #{ HUF: 499000 },
		entitlements: #{ export: 1, seats: 5, ai_credits: 1000 },
	});
	app.offer("team", #{
		name: "Team", kind: "RECURRING", service: "PLAN", family: "plan", rank: 2,
		interval: "MONTH", prices: #{ HUF: 1499000 },
		entitlements: #{ export: 1, seats: #{ amount: 1, perSeat: true }, ai_credits: 5000 },
	});
	// An add-on: no family, so it stacks with any plan.
	app.offer("storage", #{
		name: "Extra storage", kind: "RECURRING", service: "STORAGE", interval: "MONTH",
		prices: #{ HUF: 99000 }, entitlements: #{ storage: 10 },
	});
	app.offer("credits_1000", #{
		name: "1000 AI credits", kind: "ONE_TIME", service: "CREDITS", validityDays: 365,
		prices: #{ HUF: 199000 }, entitlements: #{ ai_credits: 1000 },
	});
	// Never sold (no price): only granted as a reward.
	app.offer("reward_month_pro", #{
		name: "A month of Pro", kind: "ONE_TIME", service: "PLAN", validityDays: 30,
		prices: #{}, entitlements: #{ export: 1, ai_credits: 1000 },
	});

	app.post("/api/demo/generate", generate);
	app.post("/api/demo/renew", renew);

	// Refs: an app ref type admitting at activation (`params.admits`), and a later redeem.
	app.object_type("activation", #{});
	app.on_event("AccountActivated", on_activated);
	app.post("/api/demo/activation", activation);
	app.post("/api/demo/redeem", redeem);

	app.on_init(seed);
}

/// Spends 10 `ai_credits` per call; a retried `idem` spends once. 402 `E-ENT-EXHAUSTED` when short.
pub async fn generate(ctx, req) {
	let body = req.body;
	let balance = entitle::consume(ctx, "ai_credits", 10, `${body.idem}`).await?;
	Ok(#{ balance: balance })
}

/// The `SUBSCRIPTION_RENEW` sweep at `#{at: unixSeconds}` — the suite's clock. Operator only.
pub async fn renew(ctx, req) {
	plans::renew_due(ctx, req.body.at).await?;
	Ok(#{})
}

/// Runs on its own task in the root org's `System` ctx, so it leaves a row the suite polls for.
pub async fn on_activated(ctx, event) {
	objects::put(ctx, "activation", `${event.account}`, #{ refUid: event.refUid }).await?;
	Ok(())
}

/// What `on_activated` recorded for `#{account}`, or `()`. Root org only: that is where it wrote.
pub async fn activation(ctx, req) {
	Ok(#{ row: objects::get(ctx, "activation", `${req.body.account}`).await? })
}

/// `#{org, account, appRole}`; the caller needs ADMIN on `org`, which need not be its active org.
pub async fn member_role(ctx, req) {
	auth::set_member_role(ctx, req.body).await?;
	Ok(#{})
}

/// `#{org, opts}`: a class code into `org`, which need not be the caller's active org.
pub async fn invite_code(ctx, req) {
	auth::create_invite_code(ctx, req.body.org, req.body.opts).await
}

/// `#{org}`: its class codes.
pub async fn invite_codes(ctx, req) {
	Ok(#{ items: auth::invite_codes(ctx, req.body.org).await? })
}

/// `#{name, parent?}`.
pub async fn create_org(ctx, req) {
	auth::create_org(ctx, req.body).await
}

pub async fn my_orgs(ctx, req) {
	Ok(#{ items: auth::my_orgs(ctx).await? })
}

/// `#{org?}`: without `org`, the no-argument form, which is the active org.
pub async fn members(ctx, req) {
	if req.body.get("org").is_some() {
		Ok(#{ items: auth::members_in(ctx, req.body).await? })
	} else {
		Ok(#{ items: auth::members(ctx).await? })
	}
}

/// `#{appRole?, minRank?}`.
pub async fn member_uids(ctx, req) {
	Ok(#{ items: auth::member_uids(ctx, req.body).await? })
}

/// `#{key, at}`: `settings::get` from the level `at` (`#{org?, account?}`) names.
pub async fn setting_get(ctx, req) {
	Ok(#{ value: settings::get(ctx, req.body.key, req.body.at).await? })
}

/// `#{key, value, at}`; a `()` value deletes that level's row.
pub async fn setting_set(ctx, req) {
	settings::set(ctx, req.body.key, req.body.value, req.body.at).await?;
	Ok(#{})
}

/// `#{uids}`: the public handles of any accounts.
pub async fn handles(ctx, req) {
	Ok(#{ items: auth::handles(ctx, req.body.uids).await? })
}

/// The caller's consents, app-declared `AGE16` included.
pub async fn consents(ctx, req) {
	Ok(#{ items: auth::consents(ctx).await? })
}

/// `#{account, handle}`: an operator setting or clearing (`()`) another account's handle.
pub async fn set_handle(ctx, req) {
	auth::set_handle(ctx, req.body.account, req.body.handle).await?;
	Ok(#{})
}

/// `?org=tnt_…` and any body, stored as `text/plain` and claimed by `demo:note`.
pub async fn blob_put(ctx, req) {
	let uid = blob::put(ctx, req.body, #{ org: req.query.org, mime: "text/plain", name: "note.txt" })
		.await?;
	blob::claim(ctx, uid, "demo:note").await?;
	Ok(#{ uid: uid, contentType: req.contentType, refs: blob::refs(ctx, uid).await? })
}

pub async fn blob_get(ctx, req) {
	resp::stream(blob::open(ctx, req.path.uid).await?, #{})
}

pub async fn blob_release(ctx, req) {
	blob::release(ctx, req.path.uid, "demo:note").await?;
	Ok(#{ refs: blob::refs(ctx, req.path.uid).await? })
}

pub async fn redeem(ctx, req) {
	refs::redeem(ctx, "teacher_link", req.body.code).await
}

/// The seller and the services the offers name, idempotent on every boot. A demo, so the values
/// are fixed rather than read from `.env` as `examples/booking/app-rune/seed.rn` does.
pub async fn seed(ctx) {
	invoices::put_seller(ctx, #{ seriesCode: "S-", navBaseUrl: "", navLogin: () }).await?;
	invoices::sync_seller(ctx, #{
		name: "Előfizetés Demo Kft.",
		country: "HU",
		taxNumber: "23310795208",
		postcode: "1234",
		city: "Nekeresd",
		street: "itt",
		bankAccount: "12345678-12345678-12345678",
		bankName: "Példa Bank Zrt.",
	}).await?;
	invoices::sync_services(ctx, [
		#{ code: "PLAN", name: "Előfizetés", description: (), unit: "month",
		   unitPrice: money("0.00", "HUF")?, vatCode: "STD27" },
		#{ code: "STORAGE", name: "Tárhely bővítés", description: (), unit: "month",
		   unitPrice: money("0.00", "HUF")?, vatCode: "STD27" },
		#{ code: "CREDITS", name: "AI kredit csomag", description: (), unit: "db",
		   unitPrice: money("0.00", "HUF")?, vatCode: "STD27" },
	]).await?
}
