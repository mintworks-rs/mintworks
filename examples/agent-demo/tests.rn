//! `mintworks test examples/agent-demo`.
//!
//! Each case gets its own file database and its own full build. One case per AI module is added
//! by the plan that ships it.

async fn add_note(s, body) {
	let r = test::request("POST", "/api/app/notes", Some(`${s.token}`), #{
		accountUid: `${s.accountUid}`,
		body,
	}).await?;
	assert_eq!(r.status, 200);
	Ok(())
}

async fn count_notes(s) {
	let r = test::request("GET", `/api/app/notes/${s.accountUid}/count`, None, ()).await?;
	assert_eq!(r.status, 200);
	Ok(r.body.count)
}

#[test]
pub async fn export_carries_the_script_section() {
	let s = test::session()?;
	add_note(s, "hello").await?;

	let r = test::request("GET", "/api/account/export", Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.script.notes.len(), 1);
	assert_eq!(r.body.script.notes[0].body, "hello");
}

#[test]
pub async fn a_migrated_float_column_round_trips() {
	let s = test::session()?;
	let r = test::request("POST", "/api/app/readings", Some(`${s.token}`), #{
		uid: "r1",
		value: 21.5,
	}).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.value, 21.5);

	// The migration's unique index holds.
	let r = test::request("POST", "/api/app/readings", Some(`${s.token}`), #{
		uid: "r2",
		value: 21.5,
	}).await?;
	assert_eq!(r.status, 409);
}

#[test]
pub async fn erase_removes_the_script_rows() {
	let s = test::session()?;
	add_note(s, "hello").await?;
	assert_eq!(count_notes(s).await?, 1);

	// An owner of a shared org cannot be erased (`E-AUTH-OWNER-ERASURE`): the harness seeds two.
	for org in [`${s.orgUid}`, `${s.orgBUid}`] {
		let r = test::request("DELETE", `/api/orgs/${org}`, Some(`${s.token}`), ()).await?;
		assert_eq!(r.status, 204);
	}
	let r = test::request("POST", "/api/account/delete", Some(`${s.token}`), #{
		confirmEmail: "test@example.test",
	}).await?;
	assert_eq!(r.status, 200);
	assert_eq!(count_notes(s).await?, 0);
}

#[test]
pub async fn llm_temperature_is_bounded_and_usage_reports_by_step_and_day() {
	let s = test::session()?;
	test::llm_script(["tuned"])?;
	let r = test::request("POST", "/api/app/llm/tuned", Some(`${s.token}`), #{
		text: "hi", step: "tuned", temperatureMilli: 700,
	}).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.text, "tuned");
	let r = test::request("POST", "/api/app/llm/tuned", Some(`${s.token}`), #{
		text: "hi", step: "tuned", temperatureMilli: 2001,
	}).await?;
	assert_eq!(r.status, 400);

	let r = test::request("POST", "/api/app/llm/report", Some(`${s.token}`), #{
		by: ["step", "day"],
	}).await?;
	assert_eq!(r.status, 200);
	let row = r.body.iter().find(|g| g.step == "tuned").expect("a tuned row");
	assert_eq!(row.calls, 1);
	assert_eq!(row.day.len(), 10);
	assert!(row.get("provider").is_none());
	// A plain user sees their own org's rows only, and the operator's call was not theirs.
	let u = test::signup(#{ email: "report@agent-demo.test" }).await?;
	let r = test::request("POST", "/api/app/llm/report", Some(`${u.token}`), #{
		by: ["step"],
	}).await?;
	assert_eq!(r.status, 200);
	assert!(r.body.iter().find(|g| g.step == "tuned").is_none());
	let r = test::request("POST", "/api/app/llm/report", Some(`${s.token}`), #{
		by: ["colour"],
	}).await?;
	assert_eq!(r.status, 400);
}

#[test]
pub async fn llm_usage_report_refuses_a_plain_member() {
	let a = test::signup(#{ email: "owner@agent-demo.test" }).await?;
	let b = test::signup(#{ email: "member@agent-demo.test" }).await?;
	let r = test::request("POST", "/api/orgs", Some(`${a.token}`), #{ name: "Team" }).await?;
	let team = r.body.uid;
	let r = test::request("POST", "/api/auth/switch-org", Some(`${a.token}`), #{ orgUid: team }).await?;
	let owner = r.body.accessToken;
	let r = test::request("POST", "/api/org/members", Some(`${owner}`),
		#{ email: "member@agent-demo.test", role: "MEMBER" }).await?;
	assert!(r.status < 300, "invite answered {}", r.status);
	let r = test::request("GET", "/api/org/invites", Some(`${owner}`), ()).await?;
	let code = r.body.items[0].code;
	let r = test::request("POST", `/api/org/invites/${code}/accept`, Some(`${b.token}`), ()).await?;
	assert_eq!(r.status, 204);
	let r = test::request("POST", "/api/auth/switch-org", Some(`${b.token}`), #{ orgUid: team }).await?;
	let member = r.body.accessToken;

	let r = test::request("POST", "/api/app/llm/report", Some(`${member}`), #{ by: ["step"] }).await?;
	assert_eq!(r.status, 403);
	let r = test::request("POST", "/api/app/llm/report", Some(`${owner}`), #{ by: ["step"] }).await?;
	assert_eq!(r.status, 200);
}

#[test]
pub async fn llm_answers_from_the_fake_script() {
	let s = test::session()?;
	test::llm_script(["hello from the fake"])?;
	let r = test::request("POST", "/api/app/llm", Some(`${s.token}`), #{
		accountUid: `${s.accountUid}`,
		text: "hi",
	}).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.text, "hello from the fake");
	assert_eq!(r.body.provider, "fake");
}

#[test]
pub async fn memory_keeps_versions_and_searches_current() {
	let s = test::session()?;
	let r = test::request("POST", "/api/app/memory", Some(`${s.token}`), #{
		space: `account:${s.accountUid}`,
		text: "first",
	}).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.version, 2);
	assert_eq!(r.body.body, "first appended");
	assert_eq!(r.body.first, "first");
	assert_eq!(r.body.versions, 2);
	assert_eq!(r.body.docs, 1);
	assert_eq!(r.body.hits, 1);

	let r = test::request("POST", "/api/app/memory", Some(`${s.token}`), #{
		space: "no-colon",
		text: "x",
	}).await?;
	assert_eq!(r.status, 400);
	assert_eq!(r.body.error.errCode, "E-MEMORY-KEY");
}

async fn start_run(s, input, tools) {
	let r = test::request("POST", "/api/app/agent", Some(`${s.token}`), #{ input, tools }).await?;
	assert_eq!(r.status, 200);
	Ok(r.body.run)
}

/// The run's whole SSE stream: the route ends it after the final `done`/`error`.
async fn run_events(s, run) {
	let r = test::request("GET", `/api/agent/runs/${run}/events`, Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	Ok(r.text)
}

#[test]
pub async fn agent_run_calls_the_rune_tool() {
	let s = test::session()?;
	let args = `{"accountUid":"${s.accountUid}","body":"from agent"}`;
	test::llm_script([
		#{ toolCalls: [#{ id: "c1", name: "add_note", arguments: args }] },
		"noted",
	])?;
	let run = start_run(s, "add a note", ["add_note"]).await?;

	let text = run_events(s, `${run}`).await?;
	assert!(text.contains("event: tool_result"));
	assert!(text.contains("\"ok\":true"));
	assert!(text.contains("event: done"));
	assert!(text.contains("\"status\":\"done\""));
	assert_eq!(count_notes(s).await?, 1);
}

#[test]
pub async fn agent_run_cites_a_fetched_source() {
	let s = test::session()?;
	let url = "https://example.org/vat";
	test::search_fixture(#{
		searches: [[#{ title: "VAT rates", url, snippet: "27% standard" }]],
		pages: [#{ url, title: "VAT rates", text: "The standard rate is 27%." }],
	})?;
	test::llm_script([
		#{ toolCalls: [#{ id: "c1", name: "web_search", arguments: `{"query":"vat rate"}` }] },
		#{ toolCalls: [#{ id: "c2", name: "fetch", arguments: `{"url":"${url}"}` }] },
		"The standard rate is 27% [src_…].",
	])?;
	let run = start_run(s, "what is the vat rate?", ["web_search", "fetch"]).await?;

	let text = run_events(s, `${run}`).await?;
	assert!(text.contains("\"name\":\"web_search\",\"ok\":true"));
	// The id the model cites: only a fetched page is a `sources` row.
	assert!(text.contains("\"source\":\"src_"));
	assert!(text.contains("\"status\":\"done\""));

	// The search and the fetch are charged to the thread's subject, not left unattributed.
	let r = test::request("GET", "/api/app/usage/demo", Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.spent, 2000);
}

#[test]
pub async fn agent_run_refused_up_front_writes_no_turn() {
	let s = test::session()?;
	let r = test::request("POST", "/api/app/agent/broke", Some(`${s.token}`), #{ input: "hi" })
		.await?;
	assert_eq!(r.status, 200);
	let text = run_events(s, `${r.body.run}`).await?;
	assert!(text.contains("E-LLM-BUDGET"));

	let r = test::request("GET", `/api/app/agent/${r.body.thread}/messages`, Some(`${s.token}`),
		()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.count, 0);
}

#[test]
pub async fn agent_run_cancelled_while_queued() {
	let s = test::session()?;
	test::llm_script([
		#{ toolCalls: [#{ id: "c1", name: "hold_and_cancel", arguments: "{}" }] },
		"held",
	])?;
	let run = start_run(s, "hold", ["hold_and_cancel"]).await?;
	let text = run_events(s, `${run}`).await?;
	assert!(text.contains("\"status\":\"done\""));

	let r = test::request("GET", "/api/app/agent/held", Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	let held = `${r.body.run}`;
	let text = run_events(s, `${held}`).await?;
	assert!(text.contains("event: queued"));
	assert!(text.contains("\"status\":\"cancelled\""));

	// Cancelling a run already over is a no-op.
	let r = test::request("POST", `/api/agent/runs/${held}/cancel`, Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 204);
}

async fn run_with_skills(s, body) {
	let r = test::request("POST", "/api/app/agent/skills", Some(`${s.token}`), body).await?;
	assert_eq!(r.status, 200);
	Ok(r.body)
}

fn skill_call(id, args) {
	#{ toolCalls: [#{ id, name: "skill_read", arguments: args }] }
}

#[test]
pub async fn skills_menu_and_skill_read() {
	let s = test::session()?;
	test::llm_script([
		skill_call("c1", `{"name":"demo-method"}`),
		skill_call("c2", `{"name":"demo-method","path":"references/checklist.md"}`),
		skill_call("c3", `{"name":"demo-other"}`),
		skill_call("c4", `{"name":"demo-method","path":"../demo-other/SKILL.md"}`),
		"done",
	])?;
	let r = run_with_skills(s, #{ input: "use the method", skills: ["demo-method"] }).await?;
	let text = run_events(s, `${r.run}`).await?;
	assert!(text.contains("event: done"));
	assert!(!text.contains("Demo method body in English"));

	let reqs = test::llm_requests()?;
	assert_eq!(reqs.len(), 5);
	let first = reqs[0];
	assert_eq!(first.tools, ["skill_read"]);
	assert_eq!(first.messages[0].role, "system");
	assert_eq!(first.messages[0].content,
		"Skills you can load with `skill_read` when a task needs them:\n- `demo-method`: Use when a task asks for the demo method.");
	let body = reqs[1].messages[reqs[1].messages.len() - 1];
	assert_eq!(body.tool_call_id, "c1");
	assert!(body.content.contains("Demo method body in English"));
	assert!(body.content.contains("\"lang\":\"en\""));
	assert!(body.content.contains("references/checklist.md"));
	let reference = reqs[2].messages[reqs[2].messages.len() - 1];
	assert!(reference.content.contains("Checklist marker"));
	let other = reqs[3].messages[reqs[3].messages.len() - 1];
	assert!(other.content.contains("skill demo-other is not available in this run"));
	let traversal = reqs[4].messages[reqs[4].messages.len() - 1];
	assert!(traversal.content.contains("skill demo-method has no file ../demo-other/SKILL.md"));
	assert!(text.contains("\"ok\":false"));

	let m = test::request("GET", `/api/app/agent/${r.thread}/messages`, Some(`${s.token}`), ())
		.await?;
	assert_eq!(m.status, 200);
	for msg in m.body.messages {
		assert!(!`${msg.content}`.contains("Demo method body"), "skill text reached the client");
	}
}

#[test]
pub async fn skill_read_serves_the_run_language() {
	let s = test::session()?;
	test::llm_script([skill_call("c1", `{"name":"demo-method"}`), "kész"])?;
	let r = run_with_skills(s, #{ input: "módszer", skills: ["demo-method"], lang: "hu" }).await?;
	run_events(s, `${r.run}`).await?;

	let reqs = test::llm_requests()?;
	let read = reqs[1].messages[reqs[1].messages.len() - 1];
	assert!(read.content.contains("Demo method body in Hungarian"));
	assert!(read.content.contains("\"lang\":\"hu\""));
}

#[test]
pub async fn no_skill_read_without_a_menu() {
	let s = test::session()?;
	test::llm_script([skill_call("c1", `{"name":"demo-method"}`), "done"])?;
	let r = run_with_skills(s, #{ input: "plain", skills: [] }).await?;
	let text = run_events(s, `${r.run}`).await?;
	assert!(text.contains("unknown tool skill_read"));

	let reqs = test::llm_requests()?;
	assert_eq!(reqs[0].tools.len(), 0);
	assert_eq!(reqs[0].messages[0].role, "user");
}

