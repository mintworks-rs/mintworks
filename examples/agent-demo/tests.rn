pub async fn duplicate_skill_is_refused() {
	let s = test::session()?;
	let r = test::request("POST", "/api/app/agent/skills", Some(`${s.token}`), #{
		input: "x",
		skills: ["demo-method", "demo-method"],
	}).await?;
	assert_eq!(r.status, 400);
	assert!(r.body.error.errStr.contains("duplicate skill demo-method"));
}

#[test]
pub async fn a_later_run_with_another_menu_sees_the_stub() {
	let s = test::session()?;
	test::llm_script([skill_call("c1", `{"name":"demo-method"}`), "first", "second"])?;
	let r = run_with_skills(s, #{ input: "one", skills: ["demo-method"] }).await?;
	run_events(s, `${r.run}`).await?;
	let r2 = run_with_skills(s, #{ thread: r.thread, input: "two", skills: ["demo-other"] }).await?;
	run_events(s, `${r2.run}`).await?;

	let reqs = test::llm_requests()?;
	assert_eq!(reqs.len(), 3);
	let stub = reqs[2].messages.iter().find(|m| m.role == "tool").unwrap();
	assert!(stub.content.contains("skill text not kept"));
	assert!(!stub.content.contains("Demo method body"));
	assert!(reqs[2].messages[0].content.contains("`demo-other`"));
}

#[test]
pub async fn skills_module_lists_and_reads() {
	let s = test::session()?;
	let r = test::request("GET", "/api/app/skills", Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.skills.len(), 2);
	assert_eq!(r.body.skills[0].name, "demo-method");
	assert_eq!(r.body.skills[0].references, ["references/checklist.md"]);
	assert_eq!(r.body.skills[1].name, "demo-other");

	let r = test::request("POST", "/api/app/skills/read", Some(`${s.token}`),
		#{ name: "demo-method", lang: "hu" }).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.path, "SKILL.md");
	assert_eq!(r.body.lang, "hu");
	assert!(r.body.content.contains("Hungarian"));

	let r = test::request("POST", "/api/app/skills/read", Some(`${s.token}`),
		#{ name: "demo-method", path: "references/missing.md" }).await?;
	assert_eq!(r.status, 404);
	assert_eq!(r.body.error.errCode, "E-CORE-NOTFOUND");
	let r = test::request("POST", "/api/app/skills/read", Some(`${s.token}`),
		#{ name: "nope" }).await?;
	assert_eq!(r.status, 404);

	let member = test::signup(#{ email: "member@agent-demo.test" }).await?;
	let r = test::request("GET", "/api/app/skills", Some(`${member.token}`), ()).await?;
	assert_eq!(r.status, 403);
	let r = test::request("POST", "/api/app/skills/read", Some(`${member.token}`),
		#{ name: "demo-method" }).await?;
	assert_eq!(r.status, 403);
	assert_eq!(r.body.error.errCode, "E-AUTH-FORBIDDEN");
}

#[test]
pub async fn pdf_render_queues_a_document() {
	let s = test::session()?;
	let r = test::request("POST", "/api/app/pdf", Some(`${s.token}`), #{
		title: "Demo",
		text: "Hello *world* #1",
	}).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.markup, "Hello #emph[world]; \\#1");
	let uid = `${r.body.uid}`;
	assert!(uid.starts_with("doc_"));
	// No drain in `test::`: the worker idles 5 s, so READY is not waited for here.
	assert!(r.body.status == "PENDING" || r.body.status == "READY");

	let r = test::request("GET", `/api/documents/${uid}`, Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.uid, uid);

	let unknown = "/api/documents/doc_01AAAAAAAAAAAAAAAAAAAAAAAA";
	let r = test::request("GET", unknown, Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 404);
}

