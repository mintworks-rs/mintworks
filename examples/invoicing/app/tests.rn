// ---------------------------------------------------------------- tax limits

/// `seller_session` with `fields` published over the company.
async fn regime_session(fields) {
	let s = seller_session().await?;
	let body = company();
	for (k, v) in fields {
		body.insert(k, v);
	}
	let r = test::request("PUT", "/api/seller", Some(`${s.token}`), body).await?;
	assert_eq!(r.status, 200);
	Ok(s)
}

async fn tax_limits_of(token, query) {
	let r = test::request("GET", `/api/app/tax-limits${query}`, Some(token), ()).await?;
	assert_eq!(r.status, 200);
	Ok(r.body)
}

async fn issued_rental(token) {
	let p = new_partner(`${token}`).await?;
	let inv = make_draft(`${token}`, p.body.uid).await?;
	let r = test::request("POST", `/api/app/invoices/${inv.body.uid}/issue`, Some(`${token}`),
		()).await?;
	assert_eq!(r.status, 200);
	Ok(r.body)
}

#[test]
pub async fn tax_limits_report_aam_for_an_exempt_seller() {
	let s = regime_session(#{ vatScheme: "ALANYI_MENTES" }).await?;
	issued_rental(`${s.token}`).await?;

	let now = tax_limits_of(`${s.token}`, "").await?;
	assert_eq!(now.limits.len(), 1);
	let aam = now.limits[0];
	assert_eq!(aam.kind, "AAM");
	assert_eq!(aam.basis, "INVOICED");
	assert_eq!(aam.used, 125000);
	assert_eq!(aam.limit, aam.fullLimit);
	assert_eq!(aam.crossedOn, ());
	assert_eq!(now.months.len(), 12);

	let y2026 = tax_limits_of(`${s.token}`, "?year=2026").await?;
	assert_eq!(y2026.limits[0].limit, 20000000);
}

/// KATA pro-rates by month of status: from May, 8 × 1 500 000.
#[test]
pub async fn tax_limits_prorate_kata_from_regime_since() {
	let s = regime_session(#{ incomeRegime: "KATA", regimeSince: "2026-05-01" }).await?;
	let r = tax_limits_of(`${s.token}`, "?year=2026").await?;
	assert_eq!(r.limits.len(), 1);
	assert_eq!(r.limits[0].kind, "KATA");
	assert_eq!(r.limits[0].basis, "RECEIVED");
	assert_eq!(r.limits[0].limit, 12000000);
	assert_eq!(r.limits[0].fullLimit, 18000000);
	assert_eq!(r.limits[0].since, "2026-05-01");

	// A start in an earlier year is a full year.
	let next = tax_limits_of(`${s.token}`, "?year=2025").await?;
	assert_eq!(next.limits[0].limit, 18000000);
}

/// The adómentes keret is ½ × the yearly minimum wage over (1 − költséghányad), floored.
#[test]
pub async fn atalany_taxfree_keret_follows_the_expense_ratio() {
	let s = regime_session(#{ incomeRegime: "ATALANY" }).await?;
	for (pct, keret, limit) in [
		((), 3521454, 38736000),
		(80, 9684000, 38736000),
		(90, 19368000, 193680000),
	] {
		if tl_known(pct) {
			let body = company();
			body.insert("incomeRegime", "ATALANY");
			body.insert("expenseRatioPct", pct);
			let r = test::request("PUT", "/api/seller", Some(`${s.token}`), body).await?;
			assert_eq!(r.status, 200);
		}
		let r = tax_limits_of(`${s.token}`, "?year=2026").await?;
		assert_eq!(r.limits.len(), 2);
		assert_eq!(r.limits[0].kind, "ATALANY");
		assert_eq!(r.limits[0].limit, limit);
		assert_eq!(r.limits[1].kind, "ATALANY_TAXFREE");
		assert_eq!(r.limits[1].limit, keret);
		assert_eq!(r.limits[1].taxFreeIncome, 1936800);
	}

	// A ratio belongs to átalányadó only.
	let body = company();
	body.insert("incomeRegime", "KATA");
	body.insert("expenseRatioPct", 80);
	let r = test::request("PUT", "/api/seller", Some(`${s.token}`), body).await?;
	assert_eq!(r.status, 400);
}

#[test]
pub async fn a_marked_paid_invoice_counts_as_received() {
	let s = regime_session(#{ incomeRegime: "KATA" }).await?;
	let inv = issued_rental(`${s.token}`).await?;
	let before = tax_limits_of(`${s.token}`, "").await?;
	assert_eq!(before.limits[0].used, 0);
	assert_eq!(before.limits[0].pending, 125000);

	let r = test::request("POST", `/api/app/invoices/${inv.uid}/paid`, Some(`${s.token}`), #{
		paidOn: before.today,
	}).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.status, "PAID");

	let after = tax_limits_of(`${s.token}`, "").await?;
	assert_eq!(after.limits[0].used, 125000);
	assert_eq!(after.limits[0].pending, 0);
}

#[test]
pub async fn an_unknown_year_reports_a_null_limit() {
	let s = regime_session(#{ vatScheme: "ALANYI_MENTES" }).await?;
	let r = tax_limits_of(`${s.token}`, "?year=2030").await?;
	assert_eq!(r.limits[0].kind, "AAM");
	assert_eq!(r.limits[0].limit, ());
}

