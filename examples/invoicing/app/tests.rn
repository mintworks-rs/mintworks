//! `mintworks test examples/invoicing/app`.
//!
//! Each case gets its own file database and its own full build, so no case sees another's rows.
//! `test::session()` hands out the seeded account's bearer plus a second org's — the same
//! account, OWNER in both — which is what makes the authorization case aim at a resource that
//! genuinely belongs to somebody else rather than at an unknown uid. Nothing is seeded on boot:
//! a case that drafts or touches the catalogue onboards its org first, through
//! [`seller_session`].

#[test]
pub async fn health_needs_no_token() {
	let r = test::request("GET", "/api/app/health", None, ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.status, "ok");
}

#[test]
pub async fn services_crud() {
	let s = seller_session().await?;
	let created = test::request("POST", "/api/services", Some(`${s.token}`), #{
		code: "TESTSVC",
		name: "Teszt szolgáltatás",
		unit: "db",
		unitPrice: #{ amount: "1000.00", currency: "HUF" },
		vatCode: "STD27",
	}).await?;
	assert_eq!(created.status, 201);
	let uid = created.body.uid;

	let renamed = test::request("PATCH", `/api/services/${uid}`, Some(`${s.token}`), #{
		name: "Átnevezve",
	}).await?;
	assert_eq!(renamed.status, 200);
	assert_eq!(renamed.body.name, "Átnevezve");

	// The onboarding's two plus this one.
	let listed = test::request("GET", "/api/services", Some(`${s.token}`), ()).await?;
	assert_eq!(listed.status, 200);
	assert_eq!(listed.body.items.len(), 3);

	// A well-formed uid nobody owns. The bundle keys on uid, not on code, so `NOSUCH` would
	// stop at `ServiceId::parse` as a 400 and never reach the not-found path.
	let missing = test::request("PATCH", "/api/services/svc_01JQ8F3K9M2NP4RSTVWXYZ0AB2",
		Some(`${s.token}`), #{ name: "x" }).await?;
	assert_eq!(missing.status, 404);
}

#[test]
pub async fn partners_crud() {
	let s = test::session()?;
	let p = new_partner(`${s.token}`).await?;
	assert_eq!(p.status, 201);

	let patched = test::request("PATCH", `/api/billing-parties/${p.body.uid}`, Some(`${s.token}`), #{
		city: "Szeged",
	}).await?;
	assert_eq!(patched.status, 200);
	assert_eq!(patched.body.city, "Szeged");

	let gone = test::request("DELETE", `/api/billing-parties/${p.body.uid}`, Some(`${s.token}`), ()).await?;
	assert_eq!(gone.status, 204);
}

#[test]
pub async fn draft_add_line_issue_storno() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;

	// One catalogue line, priced from the onboarded `services` row.
	let draft = test::request("POST", "/api/app/invoices", Some(`${s.token}`), #{
		partyUid: p.body.uid,
		lines: [#{ serviceCode: "RENTAL", qty: "2" }],
	}).await?;
	assert_eq!(draft.status, 201);
	let uid = draft.body.uid;

	// …and one ad-hoc line, which carries its own price, unit and VAT code.
	let lined = test::request("POST", `/api/app/invoices/${uid}/lines`, Some(`${s.token}`), #{
		description: "Helyszíni nap",
		unit: "nap",
		qty: "1",
		unitPrice: #{ amount: "85000.00", currency: "HUF" },
		vatCode: "STD27",
	}).await?;
	assert_eq!(lined.status, 200);

	let issued = test::request("POST", `/api/app/invoices/${uid}/issue`, Some(`${s.token}`), ()).await?;
	assert_eq!(issued.status, 200);

	let stornoed = test::request("POST", `/api/app/invoices/${uid}/storno`, Some(`${s.token}`), #{
		reason: "teszt",
	}).await?;
	assert_eq!(stornoed.status, 200);
}

#[test]
pub async fn quick_invoice_drafts_and_issues() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;
	let r = test::request("POST", "/api/app/quick-invoices", Some(`${s.token}`), #{
		partyUid: p.body.uid,
		lines: [#{ serviceCode: "ONSITE", qty: "1" }],
	}).await?;
	assert_eq!(r.status, 201);
	assert_eq!(r.body.status, "ISSUED");
}

/// Another org's uid is `E-CORE-NOTFOUND`, never a 403: a 403 would confirm the resource exists.
#[test]
pub async fn another_orgs_invoice_is_not_found() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;
	let draft = test::request("POST", "/api/app/invoices", Some(`${s.token}`), #{
		partyUid: p.body.uid,
		lines: [#{ serviceCode: "RENTAL", qty: "1" }],
	}).await?;
	assert_eq!(draft.status, 201);

	let seen = test::request("GET", `/api/invoices/${draft.body.uid}`, Some(`${s.tokenB}`), ()).await?;
	assert_eq!(seen.status, 404);
	assert_eq!(seen.body.error.errCode, "E-CORE-NOTFOUND");
}

/// `lineNo` arrives from the path as a string and has to reach the binding as an integer.
/// A catalogue line refuses `unitPrice` and `vatCode` in a patch the same way it refuses them
/// on create (`E-INV-LINE`), so this one edits what a catalogue line may carry.
#[test]
pub async fn a_draft_line_is_editable_and_removable() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;
	let inv = make_draft(`${s.token}`, p.body.uid).await?;
	let uid = inv.body.uid;

	let edited = test::request("PATCH", `/api/app/invoices/${uid}/lines/1`, Some(`${s.token}`), #{
		description: "Átírva",
	}).await?;
	assert_eq!(edited.status, 200);
	assert_eq!(edited.body.lines[0].description, "Átírva");

	let removed = test::request("DELETE", `/api/app/invoices/${uid}/lines/1`,
		Some(`${s.token}`), ()).await?;
	assert_eq!(removed.status, 200);
	assert_eq!(removed.body.lines.len(), 0);
}

#[test]
pub async fn a_draft_is_patchable_and_deletable() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;
	let inv = make_draft(`${s.token}`, p.body.uid).await?;
	let uid = inv.body.uid;

	let patched = test::request("PATCH", `/api/app/invoices/${uid}`, Some(`${s.token}`), #{
		notes: "Megjegyzés",
	}).await?;
	assert_eq!(patched.status, 200);
	assert_eq!(patched.body.notes, "Megjegyzés");

	let gone = test::request("DELETE", `/api/app/invoices/${uid}`, Some(`${s.token}`), ()).await?;
	assert_eq!(gone.status, 204);

	let seen = test::request("GET", `/api/invoices/${uid}`, Some(`${s.token}`), ()).await?;
	assert_eq!(seen.status, 404);
}

/// `months` excludes an invoice with no number, so only the issued one shows up there. Nothing
/// in this application records a payment, so `overdue` answers empty whatever the due date is.
#[test]
pub async fn the_summary_buckets_an_issued_invoice() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;
	let inv = make_draft(`${s.token}`, p.body.uid).await?;
	let issued = test::request("POST", `/api/app/invoices/${inv.body.uid}/issue`,
		Some(`${s.token}`), ()).await?;
	assert_eq!(issued.status, 200);

	let r = test::request("GET", "/api/app/summary", Some(`${s.token}`), ()).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.statuses.len(), 1);
	assert_eq!(r.body.statuses[0].status, "ISSUED");
	assert_eq!(r.body.months.len(), 1);
	assert_eq!(r.body.overdue.len(), 0);
}

#[test]
pub async fn an_invoice_is_assignable_and_listable_by_project() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;
	let proj = new_project(`${s.token}`, p.body.uid).await?;
	assert_eq!(proj.status, 201);

	let inv = make_draft(`${s.token}`, p.body.uid).await?;
	let set = test::request("PUT", `/api/app/invoices/${inv.body.uid}/project`, Some(`${s.token}`), #{
		projectUid: proj.body.uid,
	}).await?;
	assert_eq!(set.status, 200);

	let listed = test::request("GET", `/api/app/projects/${proj.body.uid}/invoices`,
		Some(`${s.token}`), ()).await?;
	assert_eq!(listed.status, 200);
	assert_eq!(listed.body.items.len(), 1);
	assert_eq!(listed.body.items[0].uid, inv.body.uid);
}

/// The whole reason the link is ext data in a side table rather than a field on the invoice: an
/// `ISSUED` invoice row is immutable, and the project still has to be assignable afterwards.
#[test]
pub async fn the_project_link_survives_the_invoice_going_issued() {
	let s = seller_session().await?;
	let p = new_partner(`${s.token}`).await?;
	let proj = new_project(`${s.token}`, p.body.uid).await?;
	let inv = make_draft(`${s.token}`, p.body.uid).await?;

	let issued = test::request("POST", `/api/app/invoices/${inv.body.uid}/issue`,
		Some(`${s.token}`), ()).await?;
	assert_eq!(issued.status, 200);

	// Assigned *after* the invoice is immutable, which is the case that would fail against a
	// column on `invoices`.
	let set = test::request("PUT", `/api/app/invoices/${inv.body.uid}/project`, Some(`${s.token}`), #{
		projectUid: proj.body.uid,
	}).await?;
	assert_eq!(set.status, 200);

	let listed = test::request("GET", `/api/app/projects/${proj.body.uid}/invoices`,
		Some(`${s.token}`), ()).await?;
	assert_eq!(listed.body.items[0].status, "ISSUED");
}

/// No foreign key reaches a JSON body, so the write-time read is the only guard there is.
#[test]
pub async fn a_dangling_partner_uid_is_rejected_on_write() {
	let s = test::session()?;
	let r = test::request("POST", "/api/app/projects", Some(`${s.token}`), #{
		name: "Nincs ilyen vevő",
		partyUid: "prt_01JQ8F3K9M2NP4RSTVWXYZ0AB2",
	}).await?;
	assert_eq!(r.status, 404);
	assert_eq!(r.body.error.errCode, "E-CORE-NOTFOUND");
}

/// The objects store is org-scoped, so another org's project is absent rather than forbidden — a
/// 403 would confirm it exists.
#[test]
pub async fn another_orgs_project_is_not_found() {
	let s = test::session()?;
	let p = new_partner(`${s.token}`).await?;
	let proj = new_project(`${s.token}`, p.body.uid).await?;

	let seen = test::request("GET", `/api/app/projects/${proj.body.uid}`, Some(`${s.tokenB}`), ()).await?;
	assert_eq!(seen.status, 404);
	assert_eq!(seen.body.error.errCode, "E-CORE-NOTFOUND");
}

// ---------------------------------------------------------------- onboarding

/// The company the onboarding cases register: a valid HU taxpayer, distinct from the buyer.
fn company() {
	#{
		name: "Teszt Eladó Kft.",
		country: "HU",
		taxNumber: "23456789-2-13",
		postcode: "1011",
		city: "Budapest",
		street: "Fő utca 2.",
		vatScheme: "NORMAL",
	}
}

/// [`test::session`] with its first org onboarded: its seller minted and the two catalogue rows
/// the drafting cases price from.
async fn seller_session() {
	let s = test::session()?;
	let body = company();
	body.insert("seriesCode", "SCR");
	let minted = test::request("POST", "/api/seller", Some(`${s.token}`), body).await?;
	assert_eq!(minted.status, 201);
	for (code, name, unit, amount) in [
		("RENTAL", "Eszközbérlés", "hó", "125000.00"),
		("ONSITE", "Helyszíni kiszállás", "nap", "85000.00"),
	] {
		let r = test::request("POST", "/api/services", Some(`${s.token}`), #{
			code, name, unit,
			unitPrice: #{ amount, currency: "HUF" },
			vatCode: "STD27",
		}).await?;
		assert_eq!(r.status, 201);
	}
	Ok(s)
}

#[test]
pub async fn onboarding_mints_the_orgs_seller_once() {
	let s = test::session()?;
	let first = test::request("POST", "/api/seller", Some(`${s.token}`), company()).await?;
	assert_eq!(first.status, 201);
	assert_eq!(first.body.inherited, false);
	assert_eq!(first.body.seriesCode, "A");

	let again = test::request("POST", "/api/seller", Some(`${s.token}`), company()).await?;
	assert_eq!(again.status, 409);
	assert_eq!(again.body.error.errCode, "E-INV-SELLER-EXISTS");
}

