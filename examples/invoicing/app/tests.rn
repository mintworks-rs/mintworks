#[test]
pub async fn a_company_edit_publishes_a_version() {
	let s = seller_session().await?;
	let before = test::request("GET", "/api/seller", Some(`${s.token}`), ()).await?;
	let body = company();
	body.insert("city", "Szeged");
	let r = test::request("PUT", "/api/seller", Some(`${s.token}`), body).await?;
	assert_eq!(r.status, 200);
	assert_eq!(r.body.city, "Szeged");
	assert!(r.body.sellerVer > before.body.sellerVer);
}

