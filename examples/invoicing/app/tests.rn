// ---------------------------------------------------------------- db::

#[test]
pub async fn db_roundtrip() {
	let s = test::session()?;
	let added = test::request("POST", "/api/app/ledger", Some(`${s.token}`), #{
		op: "add", day: "2026-01-02", total: 1500,
	}).await?;
	assert_eq!(added.status, 200);
	assert_eq!(added.body.rows, 1);

	let totals = test::request("POST", "/api/app/ledger", Some(`${s.token}`), #{
		op: "totals",
	}).await?;
	assert_eq!(totals.status, 200);
	assert_eq!(totals.body.items.len(), 1);
	assert_eq!(totals.body.items[0].day, "2026-01-02");
	assert_eq!(totals.body.items[0].total, 1500);
}
